+    return (mp_rand_next(s) >> 11) * 0x1.0p-53;
+}
+
+// Ref: https://www.pcg-random.org/posts/bounded-rands.html#bitmask-with-rejection-unbiased-apples-method
+uint32_t mp_rand_in_range32(struct mp_rand_state *s, uint32_t min, uint32_t max)
 {
-    return (mp_rand_next() >> 11) * 0x1.0p-53;
+    mp_assert(min < max);
+    uint32_t range = max - min;
+    uint32_t mask = mp_round_next_power_of_2(range) - 1;
