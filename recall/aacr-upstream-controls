    m = ns["merge_fragments"](obs, P)
    check("5.6 two findings survive", len(m), 2)
    check("5.6 nothing merged", [x.get("merged_from", []) for x in m], [[], []])
    r = ns["to_upstream_result"](obs, "/run", P, {})
    check("5.6 and it is withheld as ambiguous, not handed over as a wildcard",
