                 {"codex.md": "**Defect 1: parse() crashes**\n- **File:** `src/app/main.py`\n"
                              "- **Line:** 10\n- **Failure scenario:** empty list\n"})
    obs2, _ = ns["read_run"](d2)
    check("5.9 attribute bullets under a bold header stay ONE finding", len(obs2), 1)
