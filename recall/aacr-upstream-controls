with section("5.7 a bare header merges FORWARD into the body it introduces"):
    # The shipped shape from FreeCAD@ec3da2e: two `**File: ...**` lines, then the body.
    # The first went upstream as a comment with no claim in it and was scored a semantic
    # match. Fails pre-fix for the stated reason: 2 comments instead of 1.
    P = ns["diff_paths"](DIFF)
    obs = [
        {"verbatim": "**File: `src/app/main.py` (lines 10-12)**\n", "observation_id": "a",
         "location": {"path": "src/app/main.py", "line": 10}},
        {"verbatim": "**File: `lib/util/main.py` (lines 5, 8)**\n\nThe header declares the "
                     "function static; the implementation does not.\n", "observation_id": "b",
         "location": {"path": "lib/util/main.py", "line": 5}},
    ]
    m = ns["merge_fragments"](obs, P)
    check("5.7 one finding", len(m), 1)
    check("5.7 it keeps the DECLARED location, the first header's",
          m[0]["location"], {"path": "src/app/main.py", "line": 10})
    check("5.7 the body travels with it", "implementation does not" in m[0]["verbatim"], True)
    check("5.7 provenance", m[0].get("merged_from"), ["b"])
    # NEGATIVE CONTROL: a one-line finding that carries its claim is not a header. The bold
