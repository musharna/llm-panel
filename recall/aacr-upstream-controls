         "location": {"path": "src/app/main.py", "line": 10}},
        {"verbatim": "**Defect 2**\n", "observation_id": "e",
         "location": {"path": "lib/util/main.py", "line": 5}},
    ]
    check("5.7 two bare titles are two findings", len(ns["merge_fragments"](bare2, P)), 2)

