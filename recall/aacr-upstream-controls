#!/usr/bin/env python3
"""Controls for aacr-upstream, the bridge into upstream AACR-Bench's evaluator.

The bridge decides what counts as a review and where a finding lives. Both of those
silently corrupted a measurement before they were controlled, so each control below
corresponds to a defect this project actually shipped.

    aacr-upstream-controls        # run them
    aacr-upstream-controls -v     # show each
"""
import contextlib
import json
import pathlib
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent
SRC = ROOT / "aacr-upstream"
ns = {"__name__": "aacr_upstream_controls", "__file__": str(SRC)}
exec(compile(SRC.read_text(), str(SRC), "exec"), ns)          # noqa: S102

VERBOSE = "-v" in sys.argv
FAILED = []


@contextlib.contextmanager
def section(name):
    try:
        yield
    except Exception as e:                                     # noqa: BLE001
        FAILED.append(f"{name}: raised {type(e).__name__}: {e}")
        print(f"  FAIL {name} -- raised {type(e).__name__}: {e}")


def check(name, got, want):
    ok = got == want
    if not ok:
        FAILED.append(f"{name}: got {got!r}, want {want!r}")
    if VERBOSE or not ok:
        print(f"  {'ok  ' if ok else 'FAIL'} {name}")


DIFF = (
    "diff --git a/src/app/main.py b/src/app/main.py\n"
    "--- a/src/app/main.py\n"
    "+++ b/src/app/main.py\n"
    "@@ -10,3 +10,4 @@\n+x = 1\n"
    "diff --git a/lib/util/main.py b/lib/util/main.py\n"
    "--- a/lib/util/main.py\n"
    "+++ b/lib/util/main.py\n"
    "@@ -5,2 +5,3 @@\n+y = 2\n"
    "diff --git a/gone.txt b/gone.txt\n"
    "--- a/gone.txt\n"
    "+++ /dev/null\n"
)

# --- 1. the diff is the authority on what a path is --------------------------------------
with section("1.1 diff_paths reads the right-hand side and drops /dev/null"):
    p = ns["diff_paths"](DIFF)
    check("1.1 both real paths", p == {"src/app/main.py", "lib/util/main.py"}, True)
    check("1.1 /dev/null excluded", "/dev/null" in p, False)

with section("1.2 resolve_path: exact, basename, ambiguous, absent, not-in-diff"):
    P = ns["diff_paths"](DIFF)
    check("1.2 exact", ns["resolve_path"]("src/app/main.py", P), ("src/app/main.py", "exact"))
    # AMBIGUOUS: two files named main.py, so a bare basename must NOT be guessed.
    check("1.2 ambiguous is refused", ns["resolve_path"]("main.py", P), (None, "ambiguous"))
    check("1.2 absent", ns["resolve_path"](None, P), (None, "absent"))
    check("1.2 not-in-diff", ns["resolve_path"]("nope/other.py", P), (None, "not-in-diff"))

with section("1.3 a UNIQUE basename resolves to the full path upstream needs"):
    P = {"vllm/kv/multi_connector.py"}
    check("1.3", ns["resolve_path"]("multi_connector.py", P),
          ("vllm/kv/multi_connector.py", "basename"))

with section("1.4 THE SHIPPED BUG: an English phrase is not a path"):
    # claimlib is structural and cannot know what files exist; the bridge holds the diff,
    # so "cleanup/shutdown" and "assistant.enabl" must resolve to nothing.
    P = ns["diff_paths"](DIFF)
    for bogus in ("cleanup/shutdown", "assistant.enabl", "delta.conte"):
        got, why = ns["resolve_path"](bogus, P)
        check(f"1.4 {bogus!r} dropped", got, None)
        check(f"1.4 {bogus!r} reason recorded", why, "not-in-diff")

# --- 2. upstream's file naming, exactly --------------------------------------------------
with section("2.1 safe_id matches upstream's rule"):
    check("2.1", ns["safe_id"]("vllm-project/vllm@6217b0c"), "vllm-project__vllm@6217b0c")
    check("2.1 no slash survives", "/" in ns["safe_id"]("a/b/c@d"), False)

# --- 3. a judge that FAILED is not a judge that found nothing ----------------------------
def _rundir(judges, bodies):
    d = pathlib.Path(tempfile.mkdtemp())
    (d / "run.json").write_text(json.dumps({"judges": judges}))
    for fname, body in bodies.items():
        (d / fname).write_text(body)          # keys are already filenames
    return d


with section("3.1 only ok/incomplete count as reviews"):
    d = _rundir(
        [{"name": "codex", "status": "unavailable", "files": {"review": "codex.md"}},
         {"name": "big-pickle", "status": "ok", "files": {"review": "big-pickle.md"}},
         {"name": "nemotron", "status": "harness", "files": {"review": "nemotron.md"}}],
        {"codex.md": "codex usage limit reached -- resets 3:15 PM.",
         "big-pickle.md": "1. **Real defect** in `src/app/main.py:10`\n",
         "nemotron.md": "opencode exited 1: boom"})
    obs, info = ns["read_run"](d)
    check("3.1 reviews", info["reviews"], 1)
    check("3.1 judges_total", info["judges_total"], 3)
    check("3.1 degraded named", sorted(info["degraded"]),
          ["codex:unavailable", "nemotron:harness"])
    check("3.1 only the real judge's finding survives", len(obs), 1)
    # POSITIVE CONTROL: the same dir with every judge ok must yield three reviews, or this
    # control would pass on a read_run that simply stopped reading anything.
    d2 = _rundir(
        [{"name": n, "status": "ok", "files": {"review": f"{n}.md"}}
         for n in ("codex", "big-pickle", "nemotron")],
        {f"{n}.md": f"1. **Defect from {n}** in `src/app/main.py:10`\n"
         for n in ("codex", "big-pickle", "nemotron")})
    obs2, info2 = ns["read_run"](d2)
    check("3.1 positive control: 3 reviews", info2["reviews"], 3)
    check("3.1 positive control: 3 findings", len(obs2), 3)
    check("3.1 positive control: nothing degraded", info2["degraded"], [])

with section("3.2 an unreadable run.json REFUSES rather than guessing"):
    d = pathlib.Path(tempfile.mkdtemp())
    (d / "codex.md").write_text("1. **Something** in `a.py:1`\n")
    obs, info = ns["read_run"](d)          # no run.json at all
    check("3.2 returns no observations", obs, None)
    check("3.2 says why", "refusing" in (info.get("why") or "").lower(), True)

with section("3.3 a judge whose review FILE is missing is degraded, not silently skipped"):
    d = _rundir([{"name": "codex", "status": "ok", "files": {"review": "codex.md"}}], {})
    obs, info = ns["read_run"](d)
    check("3.3 no reviews", info["reviews"], 0)
    check("3.3 recorded", info["degraded"], ["codex:missing-file"])

with section("3.4 WITNESS: reviews come from run.json status, not from globbing *.md"):
    # Version-independent, so it fails on the pre-fix bridge for the STATED reason instead
    # of KeyError on a function that did not exist yet. The old code globbed every *.md in
    # the run dir, so codex's "codex exec exited 1: ..." error string entered the corpus as
    # a review with zero findings and the panel silently became 2 judges.
    _src = SRC.read_text()
    check("3.4 run.json is consulted", 'd / "run.json"' in _src, True)
    check("3.4 only answered statuses count",
          'ANSWERED = ("ok", "incomplete")' in _src, True)
    check("3.4 status is checked before extracting",
          "if status not in ANSWERED:" in _src, True)
    # and the old unconditional glob must be gone
    check("3.4 no unconditional glob of every .md",
          'for f in d.glob("*.md"):' in _src, False)


# --- 4. the upstream result shape --------------------------------------------------------
with section("4.1 to_upstream_result emits what build_target_comments_from_ocr reads"):
    obs = [{"verbatim": "  a defect  ", "observation_id": "abc123",
            "location": {"path": "src/app/main.py", "line": 10}}]
    tally = {}
    r = ns["to_upstream_result"](obs, "/run/dir", ns["diff_paths"](DIFF), tally)
    c = r["review"]["comments"][0]
    check("4.1 content stripped", c["content"], "a defect")
    check("4.1 path", c["path"], "src/app/main.py")
    check("4.1 start_line", c["start_line"], 10)
    check("4.1 end_line", c["end_line"], 10)
    check("4.1 provenance kept", c["observation_id"], "abc123")
    check("4.1 tallied", tally, {"exact": 1})

with section("4.2 an UNLOCATED finding is still emitted, with an empty path"):
    # Dropping it here would quietly raise apparent precision by hiding the panel's own
    # unlocated output. Upstream will fail to match it, which is correct and visible.
    tally = {}
    r = ns["to_upstream_result"](
        [{"verbatim": "no location", "observation_id": "z", "location": {}}],
        "/run/dir", ns["diff_paths"](DIFF), tally)
    check("4.2 still present", len(r["review"]["comments"]), 1)
    check("4.2 empty path, not dropped", r["review"]["comments"][0]["path"], "")
    check("4.2 reason recorded", tally, {"absent": 1})

print(f"\n{'FAILED' if FAILED else 'all controls green'}"
      f" ({len(FAILED)} failing)" if FAILED else "\nall controls green")
for f in FAILED:
    print("  -", f)
sys.exit(1 if FAILED else 0)
