#!/usr/bin/env python3
"""Measure a panel against AACR-Bench: REAL defects, in real PRs, with negatives.

WHY THIS EXISTS
---------------
The planted corpus reports 25/27. CR-Bench reports 32.8% recall on real PR defects. The
gap is the corpus, not the panel -- hand-planted single-mechanism defects in 40-line files
are far easier than real defects in mature codebases. The planted corpus is a development
instrument, good for controlled A/Bs where ground truth must be known and iteration cheap.
It cannot support an absolute capability claim, and no number from it should be quoted as
one.

AACR-Bench (Alibaba-Aone/aacr-bench, Apache-2.0) can, with caveats stated below.
2,145 annotated findings over 200 PRs in 50 projects and 10 languages, each with a
file/line location, a category, and -- crucially -- a LABEL: 1505 valid, 640 invalid.
The negatives are what make precision measurable, which the planted corpus cannot do at
scale because it has only three sound-scope fixtures and one proven-absence fixture.

THREE CAVEATS THAT TRAVEL WITH EVERY NUMBER THIS PRODUCES
---------------------------------------------------------
1. 1,597 of 2,145 annotations are `is_ai_comment: True`, generated by the models named in
   `source_model`. Expert-verified per the paper, but this is LLM-produced ground truth
   being used to score LLM reviewers. Every report here STRATIFIES by that flag, and the
   548 human-authored items are the number to trust.
2. Only 151 items are Python. The planted corpus is entirely Python. Cross-language
   results are not comparable to it.
3. The task shape differs. These are (PR, location, comment, label) tuples: the label says
   whether a PROPOSED COMMENT is valid, not "here are all the defects in this PR". So
   recall here means "of the label-1 comments, how many did the panel independently
   land on", and absence of a match is NOT proof the panel missed a defect -- it may have
   found a real one nobody annotated. Reported as a floor, like everything else here.

    aacr-adapter list                     # what is in the dataset
    aacr-adapter fetch --limit 5          # cache PR diffs from GitHub
    aacr-adapter match --self-test        # validate the matcher before trusting it
"""
import argparse
import collections
import json
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT.parent))
import claimlib  # noqa: E402

DATA = ROOT / "benchmarks" / "aacr-bench.json"
DIFFS = ROOT / "benchmarks" / "diffs"

# How close a panel finding must be to an annotated one to count as the same defect.
# Deliberately a RANGE OVERLAP with a small pad, not an exact line match: a judge that
# names the function and one line inside it has found the same thing as an annotation
# spanning four lines. The pad is the tunable, and it is reported with every score
# because a matcher's tolerance IS part of the measurement, not a hidden constant.
DEFAULT_PAD = 5


def load():
    if not DATA.is_file():
        sys.exit(f"missing {DATA}\n  curl -sL -o {DATA} "
                 f"https://huggingface.co/datasets/Alibaba-Aone/aacr-bench/resolve/main/dataset.json")
    return json.loads(DATA.read_text())


def by_pr(rows):
    out = collections.defaultdict(list)
    for r in rows:
        out[r["pr_url"]].append(r)
    return out


def pr_parts(url):
    m = re.match(r"https://github\.com/([^/]+)/([^/]+)/pull/(\d+)", url or "")
    return m.groups() if m else (None, None, None)


def fetch_diff(url, force=False):
    """The PR's diff, cached. Returns the text, or None with the reason printed.

    Cached because a benchmark you cannot re-run offline is a benchmark you will not
    re-run, and because 200 GitHub fetches should happen once.
    """
    owner, repo, num = pr_parts(url)
    if not owner:
        return None
    DIFFS.mkdir(parents=True, exist_ok=True)
    cache = DIFFS / f"{owner}__{repo}__{num}.diff"
    if cache.is_file() and not force:
        return cache.read_text(errors="replace")
    try:
        r = subprocess.run(
            ["gh", "api", f"repos/{owner}/{repo}/pulls/{num}",
             "-H", "Accept: application/vnd.github.v3.diff"],
            capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"    {url}: {type(e).__name__}: {e}", file=sys.stderr)
        return None
    if r.returncode != 0:
        print(f"    {url}: gh exit {r.returncode}: {r.stderr.strip()[:120]}", file=sys.stderr)
        return None
    cache.write_text(r.stdout, encoding="utf-8")
    return r.stdout


def matches(obs, gt, pad=DEFAULT_PAD):
    """Does one panel observation refer to the same place as one annotated finding?

    Requires the SAME FILE and an overlapping line range. Both halves are required for the
    same reason `detected` requires symbol AND description in one finding: a file match
    alone credits a judge for being in the right neighbourhood, and a line match alone
    credits a coincidence.

    An observation with no location cannot match anything. That is deliberate -- it means
    an unlocated finding scores zero here, which is a real limitation of this matcher and
    is reported as `unlocated` rather than hidden.
    """
    loc = obs.get("location") or {}
    path = loc.get("path")
    if not path or not gt.get("path"):
        return False
    # the annotation carries a full repo path; a judge usually names the basename
    if not (gt["path"].endswith(path) or path.endswith(gt["path"])
            or pathlib.PurePosixPath(gt["path"]).name == pathlib.PurePosixPath(path).name):
        return False
    line = loc.get("line")
    if line is None:
        return False
    lo = min(gt.get("from_line") or 0, gt.get("to_line") or 0) - pad
    hi = max(gt.get("from_line") or 0, gt.get("to_line") or 0) + pad
    return lo <= line <= hi


def score(observations, truths, pad=DEFAULT_PAD):
    """Recall against label-1 annotations, plus how often the panel lands on label-0 ones.

    The label-0 hits are NOT simply false positives -- an annotation marked invalid is a
    comment a human rejected, so a panel landing there is repeating a known-bad comment,
    which is the closest thing this dataset gives to a measurable false-positive signal.
    Reported separately and never folded into a single score.
    """
    pos = [t for t in truths if t.get("label") == 1]
    neg = [t for t in truths if t.get("label") == 0]
    hit_pos = [t for t in pos if any(matches(o, t, pad) for o in observations)]
    hit_neg = [t for t in neg if any(matches(o, t, pad) for o in observations)]
    unlocated = sum(1 for o in observations if not (o.get("location") or {}).get("line"))
    return {"n_pos": len(pos), "hit_pos": len(hit_pos),
            "n_neg": len(neg), "hit_neg": len(hit_neg),
            "observations": len(observations), "unlocated": unlocated,
            "pad": pad}


def separation(runs, pad=DEFAULT_PAD):
    """Valid-hit rate minus invalid-hit rate. REPORTED, NEVER USED TO JUDGE THE MATCHER.

    ⚠️ THIS FUNCTION WAS CONCEPTUALLY CONFUSED WHEN WRITTEN, twice over, and the reframe
    is worth more than the number.

    A label-0 annotation is a comment a human REJECTED AS WRONG about a particular place.
    A label-1 annotation is a comment accepted as right about a particular place. Both are
    ABOUT the same kind of thing in the same file, often two lines apart -- measured here,
    median distance 2. They differ in CORRECTNESS, not in ABOUTNESS.

    A matcher's job is aboutness: does this panel finding refer to the same place and the
    same thing as this annotation. So when the panel repeats a claim a human rejected, the
    matcher SHOULD match it -- that is the matcher working, and the hit is a PANEL
    false-positive signal, which is exactly why `score()` reports hit_neg separately and
    never folds it in. Treating that hit rate as evidence of matcher looseness was a
    category error: it measures the PANEL, not the instrument.

    Two attempts to make it a matcher metric both failed, and both failures are informative:
      * Counting all negatives -- forced by geometry, since 8 of 10 co-located negatives sit
        inside the pad, so correctly finding the valid item necessarily hits the invalid one.
      * Restricting to ISOLATED negatives -- leaves 11, where one item moves the figure ~9pp.
    Lexical content overlap was then measured as a tie-breaker and does not separate them
    either: valid median 0.17 vs invalid 0.16, with the sign flipping across thresholds.
    It cannot, for the reason above -- a wrong claim about line N shares its vocabulary with
    a right one. Embedding similarity would fail identically; the distinction is correctness,
    which no surface measure carries.

    WHAT ACTUALLY DIAGNOSES THE MATCHER is the pad sweep below, which needs no negatives:


    THE NUMBER THAT DECIDES WHETHER ANY RECALL FIGURE HERE MEANS ANYTHING. AACR-Bench
    carries annotations a human REJECTED (label 0). A matcher that lands on rejected
    comments as often as on valid ones is not identifying defects; it is reporting
    proximity, and its "recall" is a restatement of its own tolerance.

    Measured on the 20-PR pilot:

        pad    valid%   invalid%   separation
          0     37.7      36.8       +0.9      <- no discrimination at all
          1     62.3      42.1      +20.2
          5     83.0      57.9      +25.1
         20     94.3      73.7      +20.7
        200     98.1      78.9      +19.2

    Recall climbs monotonically from 37.7% to 98.1% purely as the tolerance widens, and
    the separation stays ~20pp throughout rather than sharpening as the match tightens.
    Both facts say the same thing: this matches WHERE a finding is, not WHAT it claims --
    and THAT is the finding that survives, because it rests on the 53 positives alone.
    """
    # ONLY ISOLATED NEGATIVES COUNT. Measured on the 20-PR pilot: of 19 label-0
    # annotations, 10 share a file with a label-1 annotation and among those the median
    # line distance is 2, with 8/10 inside the default pad. A matcher that CORRECTLY
    # identifies the valid finding at line N therefore cannot avoid also matching the
    # rejected annotation at N+-2. Counting those made the invalid-hit rate structurally
    # forced by the benchmark's layout rather than a property of the matcher -- which is
    # exactly the mistake this function was written to catch, committed inside the function
    # that catches it. A negative can only test discrimination if it is somewhere a correct
    # answer would NOT be.
    hp = np_ = hn = nn = 0
    for obs, items in runs:
        pos = [t for t in items if t.get("label") == 1]
        isolated = []
        for t in items:
            if t.get("label") != 0:
                continue
            near = [p for p in pos if p.get("path") == t.get("path")
                    and abs((p.get("from_line") or 0) - (t.get("from_line") or 0)) <= pad]
            if not near:
                isolated.append(t)
        s = score(obs, pos + isolated, pad)
        hp += s["hit_pos"]; np_ += s["n_pos"]
        hn += s["hit_neg"]; nn += s["n_neg"]
    v = 100 * hp / max(np_, 1)
    iv = 100 * hn / max(nn, 1)
    return {"valid_pct": v, "invalid_pct": iv, "separation_pp": v - iv,
            "n_pos": np_, "n_neg": nn,
            # A separation computed on a handful of negatives is noise with a sign. Below
            # this the figure is reported but must not be thresholded.
            "powered": nn >= 30}


# A recall figure is only reportable if the matcher can tell valid from invalid. Set from
# the pilot: at the pad in use the separation is ~25pp, and at pad=0 it is +0.9pp -- so any
# threshold in between distinguishes "tolerance is doing the work" from "identity is".
MIN_SEPARATION_PP = 15.0


# ------------------------------------------------------------------ matcher self-test
def self_test():
    """The matcher is an instrument. Refuse to score with one that cannot discriminate."""
    gt = {"path": "src/mod/Draw.cpp", "from_line": 100, "to_line": 104, "label": 1}
    ok = True

    def obs(path, line):
        return {"location": {"path": path, "line": line, "symbol": None}}

    cases = [
        ("exact line, full path",      obs("src/mod/Draw.cpp", 100), True),
        ("inside the range",           obs("src/mod/Draw.cpp", 102), True),
        ("basename only",              obs("Draw.cpp", 101), True),
        ("within the pad",             obs("Draw.cpp", 108), True),
        ("outside the pad",            obs("Draw.cpp", 130), False),
        ("right line, WRONG file",     obs("other.cpp", 100), False),
        ("right file, no line",        obs("Draw.cpp", None), False),
        ("no location at all",         {"location": {}}, False),
    ]
    for name, o, want in cases:
        got = matches(o, gt)
        if got != want:
            print(f"  FAIL matcher: {name}: got {got}, want {want}")
            ok = False
        else:
            print(f"  ok   matcher: {name}")
    # a matcher that says yes to everything would pass every 'True' case above
    yes_to_all = sum(1 for _, o, _ in cases if matches(o, gt))
    if yes_to_all == len(cases):
        print("  FAIL matcher: it accepts EVERY case -- it cannot discriminate")
        ok = False
    return ok


PROMPT_HEAD = (
    "Review this pull request diff for REAL DEFECTS. Report only defects you can point at, "
    "most severe first, each with a concrete failure scenario (inputs -> wrong behaviour). "
    "For every defect, name the FILE and the LINE NUMBER it lives on, taken from the diff "
    "hunk headers. Do not restate what the change does, do not praise it, and do not "
    "propose refactors.\n\n"
)


def run_pr(url, items, judges, effort, timeout):
    """Run one panel over one PR's diff and score it against that PR's annotations.

    CONTEXT IS DIFF-LEVEL ONLY, deliberately and visibly. The judges get the diff and
    nothing else -- no repository, no surrounding file. AACR-Bench labels how much context
    each finding needs (Diff / File / Repo), so this configuration should be EXPECTED to
    miss File- and Repo-level findings, and the score is broken out that way rather than
    averaged into one number that hides it. That breakdown IS the experiment: it measures
    the context policy, not only the roster.
    """
    import tempfile
    diff = fetch_diff(url)
    if not diff:
        return None
    work = pathlib.Path(tempfile.mkdtemp(prefix="aacr-"))
    prompt = PROMPT_HEAD + "```diff\n" + diff + "\n```\n"
    sib = ROOT.parent / "llm-panel"
    binary = str(sib if sib.is_file() else "llm-panel")
    r = subprocess.run([binary, "--cwd", str(work), "--judges", judges,
                        "--effort", effort, "--timeout", str(timeout), prompt],
                       capture_output=True, text=True, timeout=timeout * 3)
    blob = r.stdout + r.stderr
    m = re.search(r"panel written to (\S+?)\]", blob)
    if not m:
        print(f"    no run dir for {url}: {blob.strip()[-160:]}", file=sys.stderr)
        return None
    d = pathlib.Path(m.group(1).rstrip(":]"))
    obs = []
    for f in d.glob("*.md"):
        if f.name == "panel.md" or f.name.endswith((".prompt.md", ".live.md", ".rebuttal.md")):
            continue
        obs += claimlib.extract(f.read_text(errors="replace"),
                                judge=f.stem, run=d.name)["observations"]
    return {"url": url, "rundir": str(d), "observations": len(obs),
            "score": score(obs, items),
            "by_context": {lvl: score(obs, [t for t in items if t.get("context") == lvl])
                           for lvl in ("Diff Level", "File Level", "Repo Level")},
            "human_only": score(obs, [t for t in items if not t.get("is_ai_comment")])}


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    f = sub.add_parser("fetch"); f.add_argument("--limit", type=int, default=5)
    f.add_argument("--language"); f.add_argument("--human-only", action="store_true")
    m = sub.add_parser("match"); m.add_argument("--self-test", action="store_true")
    rs = sub.add_parser("rescore"); rs.add_argument("--tag", default="aacr")
    rn = sub.add_parser("run")
    rn.add_argument("--limit", type=int, default=1)
    rn.add_argument("--judges", default="codex,big-pickle,nemotron")
    rn.add_argument("--effort", default="high")
    rn.add_argument("--timeout", type=int, default=300)
    rn.add_argument("--language"); rn.add_argument("--human-only", action="store_true")
    rn.add_argument("--tag", default="aacr")
    a = ap.parse_args()

    rows = load()
    groups = by_pr(rows)

    if a.cmd == "list":
        print(f"  {len(rows)} annotations over {len(groups)} PRs")
        for k, lbl in (("project_main_language", "language"), ("context", "context"),
                       ("category", "category")):
            c = collections.Counter(r.get(k) for r in rows)
            print(f"  {lbl:9}: {dict(c.most_common(10))}")
        print(f"  label    : {dict(collections.Counter(r.get('label') for r in rows))}")
        print(f"  ai-authored annotations: "
              f"{sum(1 for r in rows if r.get('is_ai_comment'))}/{len(rows)}"
              f"  <- stratify on this")
        return 0

    if a.cmd == "match":
        if a.self_test:
            return 0 if self_test() else 1
        print("nothing to do: pass --self-test")
        return 0

    if a.cmd == "rescore":
        # Re-measure STORED runs with the current extractor and matcher -- no model calls.
        # This exists because the first pilot scored 0/7 and the cause was the instrument,
        # not the panel: the extractor split one finding's attribute bullets into separate
        # observations so path and line never co-occurred. Fixing it and re-scoring the same
        # runs gave 2/7. An instrument you cannot re-apply to old evidence forces you to buy
        # the evidence again every time you improve the instrument.
        if not self_test():
            print("MATCHER IS NOT DISCRIMINATING -- refusing to score."); return 1
        f = ROOT / "results" / f"{a.tag}.json"
        if not f.is_file():
            sys.exit(f"no stored run at {f}")
        old_runs = json.loads(f.read_text())
        out, tp, tn = [], 0, 0
        for rec in old_runs:
            d = pathlib.Path(rec["rundir"])
            items = groups.get(rec["url"], [])
            if not d.is_dir():
                print(f"  MISSING rundir {d}"); continue
            obs = []
            for rf in d.glob("*.md"):
                if rf.name in ("panel.md", "prompt.md") or rf.name.endswith(
                        (".prompt.md", ".live.md", ".rebuttal.md")):
                    continue
                obs += claimlib.extract(rf.read_text(errors="replace"),
                                        judge=rf.stem, run=d.name)["observations"]
            new_rec = {"url": rec["url"], "rundir": str(d), "observations": len(obs),
                       "score": score(obs, items),
                       "by_context": {lvl: score(obs, [t for t in items
                                                       if t.get("context") == lvl])
                                      for lvl in ("Diff Level", "File Level", "Repo Level")},
                       "human_only": score(obs, [t for t in items
                                                 if not t.get("is_ai_comment")])}
            out.append(new_rec)
            was, now = rec["score"], new_rec["score"]
            tp += now["hit_pos"]; tn += now["n_pos"]
            print(f"  {rec['url'].split('github.com/')[1]:38} "
                  f"obs {was['observations']:3}->{now['observations']:3}  "
                  f"unlocated {was['unlocated']:3}->{now['unlocated']:3}  "
                  f"matched {was['hit_pos']}/{was['n_pos']}->{now['hit_pos']}/{now['n_pos']}")
        f.write_text(json.dumps(out, indent=2) + "\n")
        runs = []
        for rec in out:
            d = pathlib.Path(rec["rundir"]); ob = []
            for rf in d.glob("*.md"):
                if rf.name in ("panel.md", "prompt.md") or rf.name.endswith(
                        (".prompt.md", ".live.md", ".rebuttal.md")):
                    continue
                ob += claimlib.extract(rf.read_text(errors="replace"),
                                       judge=rf.stem, run=d.name)["observations"]
            runs.append((ob, groups.get(rec["url"], [])))
        sep = separation(runs)
        print(f"\n  matched {tp}/{tn} valid annotations")
        print(f"  valid {sep['valid_pct']:.1f}%  vs  known-INVALID {sep['invalid_pct']:.1f}%"
              f"   separation {sep['separation_pp']:+.1f} pp"
              f"   (on {sep['n_neg']} ISOLATED negatives)")
        print(f"  (a hit on a REJECTED annotation is a PANEL false-positive signal, not a")
        print(f"   matcher fault -- the panel repeated a claim a human turned down.)")
        print(f"\n  *** NOT REPORTABLE AS RECALL ***")
        print(f"  This matcher agrees on WHERE a finding is, not on WHAT it claims, and the")
        print(f"  figure tracks the tolerance: 37.7% at pad=0 rising to 98.1% at pad=200 on")
        print(f"  the same stored runs. Treat {tp}/{tn} as LOCATION AGREEMENT at pad={DEFAULT_PAD},")
        print(f"  never as recall. Content overlap was tried as a tie-breaker and does not")
        print(f"  separate valid from invalid (median 0.17 vs 0.16) -- see separation().")
        print(f"  rewrote {f}")
        return 0

    if a.cmd == "run":
        if not self_test():
            print("MATCHER IS NOT DISCRIMINATING -- refusing to score."); return 1
        sel = list(groups.items())
        if a.language:
            sel = [(k, v) for k, v in sel if v[0].get("project_main_language") == a.language]
        if a.human_only:
            sel = [(k, v) for k, v in sel if any(not r.get("is_ai_comment") for r in v)]
        sel.sort(key=lambda kv: kv[1][0].get("pr_change_line_count") or 0)
        sel = sel[:a.limit]
        out = []
        for url, items in sel:
            print(f"\n  {url}  ({len(items)} annotations)")
            res = run_pr(url, items, a.judges, a.effort, a.timeout)
            if not res:
                continue
            out.append(res)
            s_ = res["score"]
            print(f"    observations={s_['observations']} (unlocated {s_['unlocated']})"
                  f"  matched {s_['hit_pos']}/{s_['n_pos']} valid,"
                  f" {s_['hit_neg']}/{s_['n_neg']} known-invalid")
            for lvl, sc in res["by_context"].items():
                if sc["n_pos"]:
                    print(f"      {lvl:11} {sc['hit_pos']}/{sc['n_pos']}")
        f = ROOT / "results" / f"{a.tag}.json"
        f.parent.mkdir(exist_ok=True)
        f.write_text(json.dumps(out, indent=2) + "\n")
        tp = sum(r["score"]["hit_pos"] for r in out); tn = sum(r["score"]["n_pos"] for r in out)
        print(f"\n  TOTAL {tp}/{tn} valid annotations matched over {len(out)} PR(s)"
              f"  -- diff-level context only; a FLOOR, see the module docstring")
        print(f"  wrote {f}")
        return 0

    if a.cmd == "fetch":
        sel = list(groups.items())
        if a.language:
            sel = [(k, v) for k, v in sel if v[0].get("project_main_language") == a.language]
        if a.human_only:
            sel = [(k, v) for k, v in sel if any(not r.get("is_ai_comment") for r in v)]
        sel.sort(key=lambda kv: kv[1][0].get("pr_change_line_count") or 0)
        sel = sel[:a.limit]
        got = 0
        for url, items in sel:
            d = fetch_diff(url)
            if d:
                got += 1
                print(f"  ok   {url}  diff={len(d)}B  findings={len(items)} "
                      f"(human {sum(1 for r in items if not r['is_ai_comment'])})")
        print(f"\n  cached {got}/{len(sel)} diffs in {DIFFS}")
        return 0 if got else 1


if __name__ == "__main__":
    sys.exit(main())
