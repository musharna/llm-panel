#!/usr/bin/env python3
"""Controls for claimlib, the one measurement boundary.

Every control corresponds to a boundary mistake this project actually shipped. The
extractor is an INSTRUMENT, so the thing that matters is not that it produces plausible
output but that it can be shown to fail when it is wrong.

    claimlib-controls        # run them
    claimlib-controls -v     # show each
"""
import contextlib
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import claimlib  # noqa: E402

VERBOSE = "-v" in sys.argv
FAILED = []
COUNT = 0          # controls run; the final line prints it so README counts have a source


@contextlib.contextmanager
def section(name):
    """A control that RAISES must report FAIL, not abort the suite."""
    try:
        yield
    except Exception as e:                                # noqa: BLE001
        FAILED.append(f"{name}: raised {type(e).__name__}: {e}")
        print(f"  FAIL {name} -- raised {type(e).__name__}: {e}")


def check(name, got, want):
    global COUNT
    COUNT += 1
    ok = got == want
    if not ok:
        FAILED.append(f"{name}: got {got!r}, want {want!r}")
    if VERBOSE or not ok:
        print(f"  {'ok  ' if ok else 'FAIL'} {name}")


def heads(text):
    return [o["heading"] for o in claimlib.extract(text)["observations"]]


# --- 1. the four header forms, each earned by a miscount --------------------------------
with section("1.1 numbered findings"):
    check("1.1", heads("1. First thing\nbody\n2) Second thing\nbody\n"),
          ["1. First thing", "2) Second thing"])

with section("1.2 markdown headings"):
    check("1.2", heads("## Alpha\nbody\n### Beta\nbody\n"), ["## Alpha", "### Beta"])

with section("1.3 bolded bullets"):
    check("1.3", heads("- **Alpha** detail\n* **Beta** detail\n"),
          ["- **Alpha** detail", "* **Beta** detail"])

with section("1.4 A BOLD LINE ALONE is a finding"):
    # The form whose ABSENCE scored two real reviews as zero findings -- and therefore as
    # abstentions, in the experiment measuring abstention.
    check("1.4", heads("**`summarise` crashes on a null**\nbody text here\n"),
          ["**`summarise` crashes on a null**"])


# --- 2. a heading must not swallow the following line -----------------------------------
with section("2.1 `\\s` matched a newline; `[ \\t]` does not"):
    # `## Reproduction` once paired with the next line's `1. Run it` and reported the
    # second line's content as the heading's own.
    r = claimlib.extract("## Reproduction\n1. Run it.\n")
    check("2.1 two findings, not one", len(r["observations"]), 2)
    check("2.1 the heading is its own", r["observations"][0]["heading"], "## Reproduction")


# --- 3. fenced code is DISPLAYED, not claimed -------------------------------------------
FENCED = (
    "1. **`fence_mask` closes on a shorter fence**\n"
    "Example:\n"
    "```\n"
    "# 1. Hidden\n"
    "# 2. Still hidden\n"
    "# 3. Visible\n"
    "```\n"
    "2. **A second real finding**\nbody\n"
)
with section("3.1 headers inside a fence are not findings"):
    # Adjudicated against a real kimi review: the incumbent counted each example line in a
    # fence as its own finding, over-splitting a 3-finding review into 11.
    check("3.1 exactly the two real findings", len(claimlib.extract(FENCED)["observations"]), 2)
    check("3.1 the example lines are not headings",
          any("Hidden" in (h or "") for h in heads(FENCED)), False)

with section("3.2 an UNCLOSED fence swallows the rest, and does not crash"):
    r = claimlib.extract("1. Real finding\n```\n2. Inside an unclosed fence\n")
    check("3.2 one finding", len(r["observations"]), 1)


# --- 4. unextracted material is REPORTED, never dropped ---------------------------------
with section("4.1 a preamble is unextracted, not a finding"):
    r = claimlib.extract("I read the file and traced it.\n\n1. A real finding\nbody\n")
    check("4.1 one finding", len(r["observations"]), 1)
    check("4.1 the preamble is reported", len(r["unextracted"]), 1)
    check("4.1 verbatim, for a human to read",
          "traced it" in r["unextracted"][0]["verbatim"], True)

with section("4.2 a review with NO parseable finding is unextracted, not empty"):
    # THE defect this whole design exists to prevent: an extraction failure silently
    # becoming "the judge found nothing", which is how two reviews were scored as
    # abstentions. Zero observations is fine; zero observations AND zero unextracted,
    # for a review with text in it, would be a lie.
    r = claimlib.extract("No real defects found. I checked the boundary values.")
    check("4.2 no findings claimed", len(r["observations"]), 0)
    check("4.2 but the text IS reported", len(r["unextracted"]), 1)

with section("4.3 nothing is lost: every non-space char is in a finding or unextracted"):
    txt = "preamble here\n\n1. Alpha\nbody\n\n## Beta\nmore body\ntrailing words\n"
    r = claimlib.extract(txt)
    seen = "".join("".join(x["verbatim"].split())
                   for x in r["observations"] + r["unextracted"])
    check("4.3 character-complete", sorted(seen), sorted("".join(txt.split())))


# --- 5. identity ------------------------------------------------------------------------
with section("5.1 observation_id is deterministic and span-derived"):
    t = "1. Alpha\nbody\n2. Beta\nbody\n"
    a = claimlib.extract(t, judge="codex", run="r1")["observations"]
    b = claimlib.extract(t, judge="codex", run="r1")["observations"]
    check("5.1 stable across calls", [o["observation_id"] for o in a],
          [o["observation_id"] for o in b])
    check("5.1 distinct per finding", len({o["observation_id"] for o in a}), 2)

with section("5.2 a different judge or run gives a different id for the same span"):
    t = "1. Alpha\nbody\n"
    x = claimlib.extract(t, judge="codex", run="r1")["observations"][0]["observation_id"]
    y = claimlib.extract(t, judge="glm", run="r1")["observations"][0]["observation_id"]
    z = claimlib.extract(t, judge="codex", run="r2")["observations"][0]["observation_id"]
    check("5.2 judge matters", x == y, False)
    check("5.2 run matters", x == z, False)

with section("5.3 spans point back into the ORIGINAL text"):
    t = "preamble\n\n1. Alpha\nbody\n"
    o = claimlib.extract(t)["observations"][0]
    check("5.3 the span reproduces the verbatim", t[o["start"]:o["end"]], o["verbatim"])


# --- 8. hierarchy: a finding's own attribute bullets are not findings -------------------
# Asked for file and line, a judge answered in exactly the shape the prompt requested and
# the bullet rule tore ONE finding into FOUR -- path in one observation, line in another,
# never co-occurring, so the location matcher scored a correct review at zero.
ATTRS = (
    "**Defect 1: `windows_os()` is undefined**\n"
    "- **File:** `src/App/MigrateMakeCommand.php`\n"
    "- **Line:** 114\n"
    "- **Failure scenario:** it dies on every platform\n"
    "\n"
    "**Defect 2: separator replacement breaks paths**\n"
    "- **File:** `src/App/MigrateMakeCommand.php`\n"
    "- **Line:** 115\n"
)
with section("8.1 attribute bullets stay inside their finding"):
    check("8.1 two findings, not seven", len(claimlib.extract(ATTRS)["observations"]), 2)

with section("8.2 and the location survives, which is the whole point"):
    o = claimlib.extract(ATTRS)["observations"][0]["location"]
    check("8.2 path", o["path"], "src/App/MigrateMakeCommand.php")
    check("8.2 line", o["line"], 114)

with section("8.3 bullets ARE findings when nothing stronger is present"):
    # The rule is hierarchy, not "bullets never count". A review whose top level IS
    # bullets must still be segmented by them.
    check("8.3 two findings",
          len(claimlib.extract("- **Alpha is wrong** detail\n- **Beta is wrong** d\n")["observations"]), 2)

with section("8.4 the discriminator is HIERARCHY, not a colon or a label vocabulary"):
    # Measured over 376 bold bullets in 351 real reviews: colon-terminated spans include
    # real findings and non-colon spans include real attribute labels, so neither side is
    # clean. These assert the rule does not secretly depend on wording.
    check("8.4 a colon-terminated bullet under a number is subordinate",
          len(claimlib.extract("1. First\nbody\n\n- **High — `x`:** it is wrong\n")["observations"]), 1)
    check("8.4 label-like bullets with no colon are top level when nothing outranks",
          len(claimlib.extract("- **Function** `foo`\n- **Defect** it breaks\n")["observations"]), 2)


# --- 10. paths are recognised STRUCTURALLY, not from a list of extensions ---------------
# The allowlist (cpp|cc|cs|...) had two faults: leftmost-first alternation parsed `Foo.cs`
# as `Foo.c`, CORRUPTING the path, and it missed 166 of AACR-Bench's 2145 annotated paths.
# The structural rule matches 2143/2145 of them. These cases are drawn from real ones.
with section("10.1 suffixes no allowlist would have contained"):
    for txt, want in [("in components/Btn.tsx:9 it breaks", "components/Btn.tsx"),
                      ("include/x.hpp:3 leaks", "include/x.hpp"),
                      ("schema at db/q.sql:12", "db/q.sql"),
                      ("config/app.xml:4 is wrong", "config/app.xml")]:
        check(f"10.1 {want}", claimlib._location(txt)["path"], want)

with section("10.2 the `Foo.cs` corruption is gone"):
    check("10.2 cs not truncated to c", claimlib._location("at Foo.cs:20")["path"], "Foo.cs")
    check("10.2 cpp intact", claimlib._location("at Foo.cpp:7")["path"], "Foo.cpp")

with section("10.3 shapes with no extension at all, and scoped packages"):
    check("10.3 extensionless with a path",
          claimlib._location("docker/images/n8n/Dockerfile:2")["path"],
          "docker/images/n8n/Dockerfile")
    check("10.3 @scoped npm path",
          claimlib._location("packages/@n8n/db/src/x.ts:5")["path"],
          "packages/@n8n/db/src/x.ts")
    check("10.3 multi-dot stem",
          claimlib._location("e2e/src/asset.e2e-spec.ts:11")["path"],
          "e2e/src/asset.e2e-spec.ts")

with section("10.4 prose that LOOKS path-shaped is not a path"):
    # The structural rule must reject these or every review sprouts phantom locations.
    for txt in ["it costs 3.14 dollars", "e.g. the handler", "version 1.2 shipped"]:
        check(f"10.4 {txt[:22]}", claimlib._location(txt)["path"], None)


# --- 9. the line parser reads the shape the prompt asks for -----------------------------
with section("9.1 `- **Line:** 114` is read"):
    check("9.1", claimlib._location("- **Line:** 114 (from hunk)")["line"], 114)

with section("9.2 plain prose forms still read"):
    check("9.2 bare", claimlib._location("line 42 of the file")["line"], 42)
    check("9.2 plural range takes the first", claimlib._location("**Lines:** 7-9")["line"], 7)

with section("9.3 it does not leap across a sentence to find a number"):
    check("9.3", claimlib._location("no line here. Meanwhile 500 users complained")["line"], None)

with section("9.4 absence is still absence"):
    check("9.4", claimlib._location("something is wrong somewhere")["line"], None)


# --- 6. location is parsed, never invented ----------------------------------------------
with section("6.1 file and line are read when stated"):
    loc = claimlib.extract("1. **Bug** in `panel.py:42` -- it breaks\n")["observations"][0]["location"]
    check("6.1 path", loc["path"], "panel.py")
    check("6.1 line", loc["line"], 42)

with section("6.2 absence is recorded as absence, not guessed"):
    loc = claimlib.extract("1. Something is wrong somewhere\n")["observations"][0]["location"]
    check("6.2 no path invented", loc["path"], None)
    check("6.2 no line invented", loc["line"], None)

with section("6.3 a symbol is taken from a code span, not from a path"):
    loc = claimlib.extract("1. `load_meta` mishandles null in `a/b.py`\n")["observations"][0]["location"]
    check("6.3 symbol", loc["symbol"], "load_meta")
    check("6.3 path", loc["path"], "a/b.py")


# --- 7. coverage is reported, not asserted ----------------------------------------------
with section("7.1 coverage counts prose inside findings"):
    check("7.1 all-findings text is fully covered",
          claimlib.coverage(claimlib.extract("1. Alpha\nbody\n"), "1. Alpha\nbody\n") == 1.0, True)

with section("7.2 empty text does not divide by zero"):
    check("7.2", claimlib.coverage(claimlib.extract(""), ""), 1.0)


# --- 10.5 a dotted CODE EXPRESSION is not a file path ------------------------------------
# Shipped: CherryHQ__cherry-studio@5644b00 produced 18 findings and ZERO usable locations,
# because the bounded suffix matched a prefix of every long dotted identifier the judges
# quoted. A silently-wrong path is worse than no path -- it is the failure this module's
# own header promises not to commit.
with section("10.5 truncated identifiers are not paths"):
    for txt, want in (("assistant.enableWebSearch is true", None),
                      ("delta.content missing", None),
                      ("chunk.textDelta here", None),
                      ("file.markdown doc", None)):
        check(f"10.5 {txt[:26]!r}", claimlib._location(txt)["path"], want)

with section("10.5 POSITIVE CONTROL: real paths still parse"):
    # Without this the control above would pass if the regex simply stopped working.
    for txt, want in (("Foo.cs:20", "Foo.cs"), ("a/b/c.py:3", "a/b/c.py"),
                      ("src/x.tsx changed", "src/x.tsx"),
                      ("vllm/kv/multi_connector.py", "vllm/kv/multi_connector.py")):
        check(f"10.5 pos {txt[:26]!r}", claimlib._location(txt)["path"], want)


# --- 11. an ABSTENTION is not a list of findings -----------------------------------------
# The shipped bug: a judge wrote "**No real defect found.**" and then a NUMBERED list of
# reasons. `_STRONG` matched the bold line and both numbers, so one abstention became three
# false defects -- fed onward as three located review comments. Markdown shape cannot tell
# an enumeration of findings from an enumeration of reasons there are none.
with section("11.1 the exact abstention sentinel yields zero observations"):
    for form in (claimlib.ABSTAIN, f"**{claimlib.ABSTAIN}**", f"  {claimlib.ABSTAIN}  "):
        r = claimlib.extract(form, judge="j", run="r")
        check(f"11.1 {form.strip()[:24]!r} observations", len(r["observations"]), 0)
        check(f"11.1 {form.strip()[:24]!r} flagged", r["abstained"], True)

with section("11.2 THE SHIPPED BUG: prose reasons after an abstention are not findings"):
    # verbatim shape from the vllm smoke run that exposed this
    # LITERAL, not claimlib.ABSTAIN: a control that imports the fix's own symbol fails on
    # pre-fix code with AttributeError -- "some exception was raised" -- which is satisfied
    # by a broken harness just as well as by the bug. Spelled out, this control fails on
    # pre-fix code for the STATED reason: 3 observations instead of 0.
    txt = ("**NO DEFECTS FOUND**\n\nThis is a standard cleanup/shutdown pattern:\n\n"
           "1. **Iterates all connectors** and calls shutdown() on each.\n"
           "2. **Catches `Exception`** (not `BaseException`), which is correct.\n")
    r = claimlib.extract(txt, judge="j", run="r")
    check("11.2 zero findings from an abstention", len(r["observations"]), 0)
    check("11.2 abstained", r["abstained"], True)
    # NEGATIVE CONTROL: the SAME structure without the sentinel must still extract, or
    # this control would pass simply because the extractor stopped working.
    r2 = claimlib.extract(txt.replace(f"**{claimlib.ABSTAIN}**", "**Defects found:**"),
                          judge="j", run="r")
    check("11.2 positive control: same shape sans sentinel still extracts",
          len(r2["observations"]) >= 2, True)
    check("11.2 positive control not flagged", r2["abstained"], False)

with section("11.3 a sentinel shown as an EXAMPLE inside a fence does not abstain"):
    # the prompt quotes the sentinel; a judge echoing the format must not silence itself
    txt = (f"The required format is:\n```\n{claimlib.ABSTAIN}\n```\n"
           "1. **Real bug** in `a/b.py:3`\n")
    r = claimlib.extract(txt, judge="j", run="r")
    check("11.3 not abstained", r["abstained"], False)
    check("11.3 the real finding survives", len(r["observations"]), 1)

with section("11.4 an abstention is visible as read material, never an empty parse"):
    r = claimlib.extract(f"**{claimlib.ABSTAIN}**\nbecause the change is trivial.\n")
    check("11.4 unextracted retains the review", len(r["unextracted"]), 1)
    check("11.4 nothing silently lost",
          claimlib.ABSTAIN in r["unextracted"][0]["verbatim"], True)

with section("11.5 a near-miss phrasing does NOT abstain (it is not a name list)"):
    for near in ("No defects found", "NO DEFECTS FOUND HERE", "LGTM", "no issues found"):
        r = claimlib.extract(f"**{near}**\n\n1. **Thing** in `a/b.py:2`\n")
        check(f"11.5 {near!r} falls through", r["abstained"], False)

with section("11.6 MEASURED, NOT CHANGED: a trailing sentinel after analysis prose abstains"):
    # An audit proposed that a sentinel quoted mid-review (as an example or instruction)
    # wrongly silences real findings. Measured against every judge review in the published
    # AACR runs first: 41 contain the sentinel; 0 have findings plus a quoted sentinel; 15
    # are a per-file walkthrough that concludes NO DEFECTS FOUND on the last line. Both
    # proposed rules -- "first line only" and "only when nothing located remains" -- would
    # have turned that walkthrough into findings. This pins the shape that actually occurs.
    txt = ("**Analysis of `src/app/main.py`:**\n\nThe indexing at line 10 stays consistent "
           "with the filter. No stale references remain.\n\n- **`lib/util/main.py`**: style "
           "only, no defect.\n\nNO DEFECTS FOUND\n")
    r = claimlib.extract(txt, judge="j", run="r")
    check("11.6 abstained", r["abstained"], True)
    check("11.6 the walkthrough is not findings", len(r["observations"]), 0)

with section("12.1 headings at every Markdown level start a finding"):
    # The extractor stopped at #### while the renderer went to ######. Fails pre-fix on
    # the STATED reason: 1 observation instead of 2 at level five.
    for level in (1, 4, 5, 6):
        h = "#" * level
        r = claimlib.extract(f"{h} First in `a/b.py:2`\nbody\n{h} Second in `a/b.py:9`\nbody\n")
        check(f"12.1 level {level} splits into two", len(r["observations"]), 2)



# --- 13. `L42` is a location only next to one -------------------------------------------
# _L_PREFIX scanned the whole chunk for any `L<digits>` token, so "the L2 cache" and
# "L1 regularization" yielded line 2 / line 1 for findings that named no location at
# all -- the fabricated location the module's own comment calls worse than none, in the
# grader that credits a finding by where it points.
with section("13.1 cache-level and regulariser vocabulary is not a line"):
    for txt in ("The L2 cache is invalidated too late in flush().",
                "Uses L1 regularization; no path given.",
                "Both L1 and L2 miss here."):
        check(f"13.1 {txt[:22]!r}", claimlib._location(txt)["line"], None)

with section("13.2 the shorthand still reads where it is one"):
    check("13.2 `foo.py` L42", claimlib._location("`foo.py` L42 leaks the handle").get("line"), 42)
    check("13.2 foo.py:L42", claimlib._location("foo.py:L42 leaks the handle").get("line"), 42)
    check("13.2 at L42", claimlib._location("the handle leaks at L42").get("line"), 42)
    check("13.2 a bullet starting with L42", claimlib._location("- L42: the handle leaks").get("line"), 42)

print(f"\nFAILED ({len(FAILED)} of {COUNT} failing)" if FAILED else f"\nall {COUNT} controls green")
for f in FAILED:
    print("  -", f)
sys.exit(1 if FAILED else 0)
