# --- 24. judge identity colour must be DISTINGUISHABLE ----------------------
# A fixed palette picked by hash does not bound how close two picks land: the first roster
# it ran on gave claude-opus 235 and or-glm 210, two blues nobody can separate at 8px.
# Identity colour you cannot tell apart is worse than none -- it still looks like
# information. Hues are now spaced across the roster, which is optimal by construction.
with section('24. judge identity colour'):
    def _sep(hs):
        hs = list(hs)
        return min((min(abs(a - b), 360 - abs(a - b))
                    for i, a in enumerate(hs) for b in hs[i + 1:]), default=999)

    _r5 = ["claude-opus", "codex", "or-deepseek", "or-glm", "or-kimi"]
    check("5 judges are >= 60 deg apart", _sep(pr.judge_hues(_r5).values()) >= 60, True)
    check("8 judges are still >= 40 deg apart",
          _sep(pr.judge_hues([f"j{i}" for i in range(8)]).values()) >= 40, True)
    check("one judge does not crash", len(pr.judge_hues(["solo"])), 1)
    check("no judges does not crash", pr.judge_hues([]), {})
    check("deterministic for a roster",
          pr.judge_hues(["codex", "or-glm"]), pr.judge_hues(["or-glm", "codex"]))
    check("every judge gets a hue", len(pr.judge_hues(_r5)), 5)
    check("hues are in range", all(0 <= h < 360 for h in pr.judge_hues(_r5).values()), True)
    # the pre-fix hash-into-palette form MUST collide, or this control proves nothing
    _PAL = (210, 25, 190, 330, 265, 45, 150, 300, 15, 235)
    _old = {n: _PAL[int(__import__("hashlib").sha256(n.encode()).hexdigest()[:8], 16)
                    % len(_PAL)] for n in _r5}
    check("  (the pre-fix palette put two judges within 30 deg)", _sep(_old.values()) <= 30, True)
    # class names must be usable as CSS selectors
    # A digest is appended now: sanitising alone collided (`a-b` and `a.b` both became
    # `a-b`), so two distinct judges emitted the same CSS class and wore one colour while
    # judge_hues had correctly given them two. Raised by codex 2026-08-22.
    check("slug is css-safe", bool(re.fullmatch(r"[a-z0-9-]+", pr.judge_slug("or-glm/free.v2"))), True)
    check("slug keeps a readable stem", pr.judge_slug("or-glm/free.v2").startswith("or-glm-free-v2"), True)
    check("slug never empty", bool(pr.judge_slug("!!!")), True)
    check("DISTINCT judges get DISTINCT slugs",
          pr.judge_slug("a-b") == pr.judge_slug("a.b"), False)
    check("the same judge is stable", pr.judge_slug("codex"), pr.judge_slug("codex"))

