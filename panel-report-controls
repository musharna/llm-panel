# --- 36. J2: the link scan is LINEAR, not merely faster ---------------------
# `[x](https://a` repeated has a one-char label and no closing paren, so the unbounded
# `[^)\s]+` swallowed the review from every link start: 1.98s on 102 KB, growing
# superlinearly, on text a judge can paste. An atomic group alone took it to 0.71s and left
# the COMPLEXITY quadratic (406 KB still cost 12.5s -- 17x the time for 4x the input).
# Bounding the URL is what made it linear. So the control asserts the SCALING, not a
# wall-clock number: a timing threshold passes on a quadratic scan given a fast enough
# machine, and that is exactly how the first fix looked good.
import time as _time


def _scan_secs(n):
    _t = _time.time()
    pr._inline("[x](https://a" * n)
    return _time.time() - _t


with section("36.J2 the link scan does not blow up on adversarial input"):
    _t1 = _scan_secs(8000)
    _t4 = _scan_secs(32000)
    # Linear predicts ~4x. Quadratic predicts ~16x. 8x is a generous ceiling that still
    # separates them, and tolerates a noisy machine.
    check("36.J2 4x the input costs less than 8x the time",
          _t4 < max(_t1, 0.005) * 8, True)

