#!/usr/bin/env python3
"""Regression controls for panel-report.

Every control here corresponds to a defect that SHIPPED. The earlier round of
controls was ad-hoc and lived only in a session scratch dir, so "8 controls
green" was never reproducible by anyone -- including me, one session later.
A control that is not on disk is not a control.

Each control asserts the FIXED behaviour AND, where the pre-fix input is
representable, that the broken pattern would have failed on it: an assertion
that passes on both the broken and fixed code tells you nothing.

    panel-report-controls          # run them
    panel-report-controls -v       # show each
"""
import contextlib
# `importlib.machinery` is used below and was NEVER imported here. It worked only because
# something else on the 3.13 import path pulls the submodule in as a side effect; on 3.11
# the suite died at import with AttributeError and reported NOTHING -- a controls file that
# cannot run is indistinguishable from one that found no problems. Its two sibling suites
# both import it explicitly; this one was the odd file out.
import importlib.machinery
import importlib.util
import pathlib
import re
import sys

# Read our own flags BEFORE clobbering argv for the import below. The first version
# of this file set argv first, so -v silently did nothing: a harness that cannot show
# its own work is the same defect class it exists to catch.
VERBOSE = "-v" in sys.argv

# Prefer the panel-report SITTING BESIDE THIS FILE, falling back to the installed copy.
# Always importing ~/.local/bin meant a modified checkout could be broken while the
# controls happily verified the installed binary and reported green. Found by codex.
_sib = pathlib.Path(__file__).resolve().parent / "panel-report"
SRC = _sib if _sib.is_file() else pathlib.Path.home() / ".local/bin/panel-report"
spec = importlib.util.spec_from_loader("pr", importlib.machinery.SourceFileLoader("pr", str(SRC)))
pr = importlib.util.module_from_spec(spec)
sys.argv = ["panel-report", "--help-noop"]
try:
    spec.loader.exec_module(pr)
except SystemExit:
    pass

FAILED = []


@contextlib.contextmanager
def section(name):
    """A control that RAISES must report FAIL, not abort the suite. Run against the pre-fix
    binary, section 4 died on an AttributeError and left every later control unrun and
    unreported -- the same defect class as the dead IMG_TYPES control it existed to prove.
    A harness that stops at the first surprise cannot tell you what else is broken."""
    try:
        yield
    except Exception as e:                                # noqa: BLE001
        FAILED.append(f"{name}: raised {type(e).__name__}: {e}")
        print(f"  FAIL {name} -- raised {type(e).__name__}: {e}")


def check(name, got, want):
    ok = got == want
    if not ok:
        FAILED.append(f"{name}: got {got!r}, want {want!r}")
    if VERBOSE or not ok:
        print(f"  {'ok  ' if ok else 'FAIL'} {name}")


# --- 1. tag extraction: spaced citation forms -------------------------------
# The shipped pattern required the letter and number to be ADJACENT, so or-kimi's
# "A #1" / "Reviewer A #2" fell into the untagged bucket -- 20 of its 25 positions,
# an entire judge, while the page reported confident findings.
# Bound to the SHIPPED pattern, not a copy of it. With a local copy this control
# passed while the real regex regressed -- verified by reverting panel-report's
# pattern and watching these very assertions stay green.
with section('1. tag extraction: spaced citation forms'):
    TAG = pr.TAG_RE
    OLD = re.compile(r"(?<![A-Za-z0-9])([A-Z])[.#]?(\d+[a-z]?)\b")            # pre-fix form
    LOOSE = re.compile(r"(?<![A-Za-z0-9])(?:Reviewer\s+)?([A-Z])\s*[.#]?\s*(\d+[a-z]?)\b")

    # Bound to the shipped HELPER, not to group indices: TAG_RE has three alternatives,
    # so a positional group(1)/group(2) read returns None for two of the three and would
    # report "no tag" on citations that matched perfectly well.
    tag = pr.tag_of


    for text, want in [("image-filename injection (A #1).", "A1"),
                       ("clearance was wrong (Reviewer A #2, Rev B)", "A2"),
                       ("`\\b` prefix collision (B #1, extending mine)", "B1"),
                       ("`secs: null` crashes formatting (B #10).", "B10"),
                       ("footer mislabels source (B #2b).", "B2b"),
                       ("the bold regex spans too far (A.12 codex)", "A12"),
                       ("crossed tags (C#3)", "C3")]:
        check(f"tag {text[:34]!r}", tag(text), want)

    # label-adjacent forms: the qualifier group used to eat these
    for text, want in [("UPHOLD A1: race confirmed", "A1"),
                       ("REJECT B7 — the escape runs first", "B7"),
                       ("**MISSED A13** — all four verified", "A13")]:
        check(f"tag {text[:30]!r}", tag(text), want)

    # the pre-fix pattern MUST fail on the spaced forms, else this control proves nothing
    check("pre-fix pattern misses 'A #1'", bool(OLD.search("injection (A #1).")), False)
    check("pre-fix pattern still gets 'A.12'", bool(OLD.search("(A.12 codex)")), True)

# --- 1b. A BARE SPACE IS NOT A CITATION -------------------------------------
# The first widening allowed [A-Z]\s*\d+, which recovered "A #1" and also invented
# A3x/A2024/A5 out of "A 3x speedup", "A 2024 study", "A 5% regression". One real
# instance existed in the corpus ("A 24-model roster" -> A24). Found by the panel.
with section('1b. A BARE SPACE IS NOT A CITATION'):
    for text in ["A 3x speedup over the baseline", "A 2024 study showed",
                 "the B 52 bomber", "A 5% regression", "I 3 times confirmed this",
                 "A 24-model roster needs trimming"]:
        check(f"no phantom in {text[:28]!r}", tag(text), None)
        # and the permissive form MUST invent one, or this control proves nothing
        check(f"  (permissive form did invent it: {text[:20]!r})",
              bool(LOOSE.search(text)), True)

    # and the widened form must not invent tags out of prose
    for text in ["REJECT: the fix is wrong, see the code",
                 "UPHOLD: Python 3 is required here",
                 "CONCEDE: I was wrong about escaping"]:
        check(f"no tag in {text[:32]!r}", tag(text), None)

# --- 2. bold repair ---------------------------------------------------------
# The verdict label sits INSIDE the bold (`**REJECT -- ...**`), so stripping the
# label orphans the CLOSER. The first fix synthesised an OPENER when the count was
# odd, which on text containing backticks added a third marker.
with section('2. bold repair'):
    def repair(line, text):
        if line.lstrip().startswith("**") and "**" in text:
            text = text.replace("**", "", 1)
        return text


    check("orphan closer removed", repair("**REJECT: x is wrong.**", " x is wrong.**"), " x is wrong.")
    check("balanced bold untouched", repair("REJECT: a **real** point", " a **real** point"),
          " a **real** point")

# --- 3. imported NUL bug ----------------------------------------------------
# Copied in from session-report with its 6 controls, none of which covered NUL.
with section('3. imported NUL bug'):
    check("NUL does not corrupt spans", "\x00" in pr._inline("a\x00b"), False)

# --- 3b. run discovery covers BOTH roots ------------------------------------
# llm-panel refuses to write inside the reviewed repo and falls back to
# ~/.llm-panel. Running a panel from $HOME trips that check (XDG_CACHE_HOME is
# under $HOME), so real runs landed in the fallback and a single-root reader
# reported "no runs found" for panels sitting on disk.
with section('3b. run discovery covers BOTH roots'):
    check("run discovery has two roots", len(getattr(pr, "RUNS_ROOTS", [])), 2)
    check("fallback root included",
          any(str(r).endswith(".llm-panel/runs") for r in getattr(pr, "RUNS_ROOTS", [])), True)

# --- 3a. the label must not eat the grouping key -----------------------------
# LABEL's qualifier group ([^:—–]{0,24}) consumes a tag placed BEFORE the
# separator, so searching only the post-label remainder lost it. Zero instances
# in the corpus at the time -- and it goes live precisely because the rebuttal
# prompt now asks judges to write `UPHOLD B7: ...`. Found by the panel.
with section('3a. the label must not eat the grouping key'):
    # BOTH letters: a tag whose letter is not a reviewer is no longer a tag (audit 3 --
    # "the H2 heading" was filing positions under a finding H2). This fixture declared
    # only A, so B7 was correctly rejected. The FIXTURE was wrong, not the rule.
    _run = {"letters": {"A": "codex", "B": "opus"}, "judges": {"j": {"family": "X", "rebuttal":
            "UPHOLD A1: race confirmed\nREJECT B7 — the escape runs first\n"
            "UPHOLD: A1 already worked\n"}}}
    check("tag survives 'UPHOLD A1:' / 'REJECT B7 —'",
          [c["tag"] for c in pr.claims_of(_run)], ["A1", "B7", "A1"])

# --- 3d. multi-line positions must not be truncated --------------------------
# Reading one line per position cut a claim mid-sentence -- "the harness claim
# fails because" with the because-clause dropped -- which reads as a complete
# thought rather than as missing text. Flagged independently by two judges.
with section('3d. multi-line positions must not be truncated'):
    _ml = {"letters": {"A": "codex"}, "judges": {"j": {"family": "X", "rebuttal":
           "**REJECT: A1** — the harness claim fails because\n"
           "the guard runs BEFORE the parse step.\n\n"
           "**UPHOLD: A2** — single line.\n"
           "## Heading must not be absorbed\n"}}}
    _cs = pr.claims_of(_ml)
    check("continuation line absorbed", "guard runs BEFORE" in _cs[0]["text"], True)
    check("continuation is not a new position", len(_cs), 2)
    check("heading not absorbed", "Heading must not" in _cs[1]["text"], False)

# --- 3c. locale-independent file IO -----------------------------------------
# Found by the panel: every read_text() omitted encoding=, so under LC_ALL=C
# (cron, jobd) the first em dash in judge text raised UnicodeDecodeError and no
# report was produced. Confirmed by RUNNING it under LC_ALL=C, not by reading.
with section('3c. locale-independent file IO'):
    _src = SRC.read_text(encoding="utf-8")
    check("no locale-dependent read_text()", "read_text()" in _src, False)
    check("no locale-dependent write_text(", re.search(r"write_text\([^)]*\)(?<!utf-8\"\))", _src)
          is not None and "encoding" not in _src, False)

    # The compile check that the syntax check missed: ast.parse accepts a duplicate
    # keyword argument, py_compile does not. A sed pass introduced exactly that and
    # "parses ok" reported success on a file that could not run.
    try:
        compile(_src, str(SRC), "exec")
        check("source compiles", True, True)
    except SyntaxError as e:
        check(f"source compiles ({e})", False, True)

# --- 4. HTML injection via image filename -----------------------------------
# MIME subtype came from p.suffix and was interpolated unescaped into src.
# THE GUARD WAS THE DEFECT: `if hasattr(pr, "IMG_TYPES")` was always False (the dict was a
# local literal inside build()), so this control never executed, printed nothing even under
# -v, and the suite still reported "all controls green". Three judges found it. A control
# may not decide for itself whether to run: assert the symbol EXISTS, then use it.
with section('4. HTML injection via image filename'):
    check("IMG_TYPES is reachable (this control can run at all)", hasattr(pr, "IMG_TYPES"), True)
    check("image mime is a whitelist", 'p" onerror="alert(1)' in pr.IMG_TYPES, False)
    check("unknown extension is refused, not served as png", pr.IMG_TYPES.get("bmp"), None)
    check("known extension still maps", pr.IMG_TYPES.get("png"), "png")

# --- 5. nested-list recursion ----------------------------------------------
# ~1,200 nested levels raised RecursionError and produced NO html at all.
# `check("deep nesting renders", True, True)` asserted a TAUTOLOGY inside the try: it
# passed if md() returned "" -- the very outcome (no html at all) the control exists to
# rule out. Assert the OUTPUT, not the absence of an exception. Found by opus.
with section('5. nested-list recursion'):
    deep = "\n".join("  " * i + "- x%d" % i for i in range(400))
    try:
        _h = pr.md(deep)
        check("deep nesting renders every item", _h.count("<li>"), 400)
        check("deep nesting produced html", len(_h) > 400, True)
    except RecursionError:
        check("deep nesting renders (RecursionError)", False, True)

# --- 6. link URL escaping ---------------------------------------------------
# The old form was a three-way `and` asserted False, which also passed if link rendering
# broke ENTIRELY (no "<a" at all) -- pass-on-broken-both-ways, the exact defect class this
# file's docstring names. Split it: the link must RENDER (positive control) and the quote
# must be escaped (negative control). Two judges rated this a live XSS; it is not, and this
# control is what says so -- html.escape() runs before the link regex.
with section('6. link URL escaping'):
    _x = pr._inline('[c](https://x/"onclick="alert(1))')
    check("link renders at all (positive control)", "<a href=" in _x and ">c</a>" in _x, True)
    check("link url quote is escaped", '"onclick="' in _x, False)
    check("link url quote became an entity", "&quot;onclick=&quot;" in _x, True)

# --- 7. a position may be preceded by ANY markup ----------------------------
# `^\s*\**` enumerated whitespace and asterisks; bullets, numbers, quotes and table cells
# are markup too. A judge writing its rebuttal as a list contributed ZERO positions and
# rendered identically to one that skipped the round. Raised by four of five judges, and
# the FOURTH miss of this same class. Markup is stripped structurally now.
with section('7. a position may be preceded by ANY markup'):
    def kinds(rb):
        return [p["kind"] for p in pr.scan_positions(rb)]


    for line, want in [("- **UPHOLD** — A1 stands.", ["UPHOLD"]),
                       ("1. **REJECT**: B2 is wrong.", ["REJECT"]),
                       ("  * CONCEDE — A3 conceded", ["CONCEDE"]),
                       # ("> REJECT: ...", ["REJECT"]) -- REVERSED 2026-08-22, see below.
                       ("| MISSED: A4 in a table cell", ["MISSED"]),
                       ("UPHOLD:no space after the colon", ["UPHOLD"]),
                       ("**MISSED A13** — all four verified", ["MISSED"])]:
        check(f"markup {line[:30]!r}", kinds(line), want)

    # the pre-fix pattern MUST miss these, or this control proves nothing
    OLD_LABEL = re.compile(r"^\s*\**(UPHOLD|REJECT|CONCEDE|MISSED)\**([^:—–]{0,24})?\s*[:—–]\s", re.I)
    check("pre-fix pattern missed the bulleted form",
          bool(OLD_LABEL.match("- **UPHOLD** — A1 stands.")), False)
    check("pre-fix pattern still gets the plain form",
          bool(OLD_LABEL.match("UPHOLD: plain form ")), True)

# --- 8. a verdict is a WORD, not a substring --------------------------------
# No \b after the alternation, plus a 24-char slack qualifier, counted `REJECTED:`,
# `CONCEDED:`, `UPHOLDING:` and "Rejecting the premise here:" as positions -- a past-tense
# summary line invented cards nobody wrote. Two such lines exist in the corpus.
with section('8. a verdict is a WORD, not a substring'):
    for line in ["REJECTED: none of these survive", "CONCEDED: the caching point",
                 "UPHOLDING: previous reasoning", "Rejecting the premise here: escaping is fine",
                 "**Upholds**: I correctly identified many issues:",
                 "**Rejections**: Only Reviewer A #1 is overstated"]:
        check(f"not a position {line[:32]!r}", kinds(line), [])
        check(f"  (pre-fix pattern DID count it: {line[:20]!r})",
              bool(OLD_LABEL.match(line)), True)

# --- 9. a verdict inside a fence is a QUOTATION -----------------------------
# A rebuttal round is mostly judges quoting each other, so `REJECT:` inside a fence is the
# likeliest false position on the page. One exists in the corpus: or-glm quoting an example
# was credited with a REJECT it never made.
with section('9. a verdict inside a fence is a QUOTATION'):
        # A BLOCKQUOTE IS A QUOTATION TOO -- and this REVERSES an earlier decision, so it is
    # recorded rather than quietly swapped. The 2026-08-21 panel (opus, finding 1) listed
    # `> REJECT: ...` among the forms that SHOULD count, and it was made to count. The
    # 2026-08-22 panel (codex, finding 3) showed the cost of that: "Reviewer B wrote:" followed
    # by `> REJECT A1: ...` credited the QUOTING judge with a REJECT it never made, moving the
    # scoreboard, the filter totals and the finding mix. Quoting a peer's line is common in a
    # rebuttal round; writing your own position as a blockquote is rare. codex's case is
    # concrete and opus's was a form-completeness argument, so codex wins and `>` is treated
    # exactly like a fence.
    _quoted = "Reviewer B wrote:\n> REJECT A1: this dereference is unsafe.\n"
    check("a blockquoted verdict is a QUOTATION, not a position", kinds(_quoted), [])
    check("  (it used to be credited to the quoting judge)",
          bool(re.match(r"^(?:\s*(?:[-*+]|\d+[.)]|>|\|)\s*)*\s*\**\s*", "> REJECT A1: x")), True)
    _fenced = "UPHOLD: a real position\n\n```\nREJECT: quoted from another judge\n```\n"
    check("fenced verdict not counted", kinds(_fenced), ["UPHOLD"])
    check("  (pre-fix counted the quotation too)",
          len([l for l in _fenced.split("\n") if OLD_LABEL.match(l)]), 2)
    check("tilde fence too", kinds("UPHOLD: real\n~~~\nREJECT: quoted\n~~~\n"), ["UPHOLD"])
    check("text after a fence closes is live again",
          kinds("```\nREJECT: quoted\n```\nUPHOLD: real\n"), ["UPHOLD"])

# --- 10. the orphaned bold marker is found by COUNTING, not by position -----
# `text.replace("**", "", 1)` assumed the first marker was the orphan. When the label was
# written `**REJECT**:` the label's own bold is already closed, so the text's bold is
# balanced and the repair destroyed a legitimate OPENER, rendering a literal `B2**`.
with section('10. the orphaned bold marker is found by COUNTING, not by po'):
    def one(rb):
        return pr.claims_of({"letters": {}, "judges": {"j": {"family": "X", "rebuttal": rb}}})[0]["text"]


    check("balanced bold survives", one("**REJECT**: A1 is wrong and **B2** is right."),
          "A1 is wrong and **B2** is right.")
    check("orphan closer removed", one("**REJECT: x is wrong.**"), "x is wrong.")
    check("orphan removed is the LAST", one("**REJECT: see **this** point.**"),
          "see **this** point.")

# --- 11. a run.json judge missing fields must not kill the report ------------
# `.get("secs", 0)` guards a MISSING key, not a null value. `"secs": null` -- what a
# serialiser writes for a judge that timed out -- raised TypeError out of build() and wrote
# NO html at all. Three judges found it. Normalisation now happens once, where the record
# is built, not at each of the ~12 places that read it.
with section('11. a run.json judge missing fields must not kill the report'):
    import json, tempfile, os

    def mkrun(files):
        d = pathlib.Path(tempfile.mkdtemp(prefix="prctl-"))
        for name, body in files.items():
            (d / name).write_text(body, encoding="utf-8")
        return d


    _d = mkrun({"run.json": json.dumps({"judges": [
            {"name": "alpha", "model": "m", "secs": None, "status": "ok", "meta": {}, "labels": {}},
            {"name": "beta", "model": "m"}]}),
        "panel.md": "## Synthesis (by `alpha`)\n\nfine.\n",
        "alpha.md": "a\n", "beta.md": "b\n"})
    try:
        _run = pr.load_run(_d)
        check("null secs survives load_run", _run["judges"]["alpha"]["secs"], None)
        check("judge with no meta gets one", _run["judges"]["beta"]["meta"], {})
        check("judge with no status gets one", isinstance(_run["judges"]["beta"]["status"], str), True)
        _html = pr.build(_run, type("O", (), {"max_image_kb": 400})())
        check("report is produced despite null secs", "<html" in _html, True)
        check("absent time renders as an absence, not 0.0s", "0.0s" in _html, False)
    except Exception as e:                                    # noqa: BLE001
        check(f"null secs must not crash ({type(e).__name__}: {e})", False, True)

# --- 12. THE ROSTER IS AUTHORITATIVE FROM THE FILESYSTEM --------------------
# panel.md embeds every review verbatim, so a review QUOTING a section heading is
# indistinguishable from a real one by any pattern -- a planted
# `## fake (`demo`) — 1.0s, $999` inside a review body rendered a judge named `fake`.
# And a run.json listing fewer judges than the directory holds silently DELETED the rest:
# 5 reviews on disk rendered a 4-judge page reading "4/4 answered", no warning anywhere.
with section('12. THE ROSTER IS AUTHORITATIVE FROM THE FILESYSTEM'):
    _d = mkrun({
        "panel.md": ("## alpha (`m1`) — 1.0s, $1,234.56 used\n\nI think a heading like\n"
                     "## fake (`demo`) — 1.0s, $999\nwould be bad.\n\n"
                     "## Synthesis (by `alpha`)\n\nPart one.\n\n---\n\nPart two.\n"),
        "alpha.md": "review a\n"})
    _run = pr.load_run(_d)
    check("prose cannot forge a judge", "fake" in _run["judges"], False)
    check("the real judge is still found", "alpha" in _run["judges"], True)
    # 14. numeric parse: the heading read `$1,234.56` as `$1` -- a 1000x understatement
    check("comma-formatted cost parsed whole", _run["judges"]["alpha"]["meta"]["cost"], 1234.56)
    # 15. synthesis truncated at an ordinary horizontal rule; three judges raised it
    check("synthesis survives a `---` rule", "Part two" in (_run["synthesis"] or ("", ""))[1], True)

    _d = mkrun({"run.json": json.dumps({"judges": [
            {"name": "alpha", "model": "m1", "secs": 1.0, "status": "ok",
             "meta": {"cost": 1.0}, "labels": {}}]}),
        "panel.md": "## Synthesis (by `alpha`)\n\nsyn.\n",
        "alpha.md": "a\n", "beta.md": "b\n"})
    _run = pr.load_run(_d)
    check("a judge on disk is not deleted by a short run.json", "beta" in _run["judges"], True)
    check("and the discrepancy is reported, not swallowed", _run["roster_gap"], ["beta"])

# --- 13. a status marker is read by POSITION, not by substring --------------
# `"**DID NOT ANSWER" in sec` marked codex `harness` on a 6,954-byte review whose only
# offence was DESCRIBING this bug -- the defect reported itself into existence. The marker
# is written IN PLACE OF the review, so it opens the section; prose merely mentions it.
with section('13. a status marker is read by POSITION, not by substring'):
    _d = mkrun({
        "panel.md": ("## alpha (`m1`) — 1.0s, $1\n\nA review that says **DID NOT ANSWER while\n"
                     "discussing the parser.\n\n"
                     "## beta (`m2`) — 2.0s, $2\n\n**DID NOT ANSWER — our harness failed.**\n\n"
                     "## Synthesis (by `alpha`)\n\nsyn.\n"),
        "alpha.md": "a\n", "beta.md": "b\n"})
    _run = pr.load_run(_d)
    check("mentioning the marker does not fail a judge", _run["judges"]["alpha"]["status"], "ok")
    check("a real marker still fails its judge", _run["judges"]["beta"]["status"], "harness")

    # 16. numbers that cannot be read are an absence, not a crash
    check("malformed number does not abort", pr._num("1.2.3"), None)
    check("comma number parses", pr._num("1,234.56"), 1234.56)
    check("bare dot does not raise", pr._num("."), None)

# --- 17. a list must not silently lose items --------------------------------
# build() entered at the FIRST item's indent and discarded the index it returned, so any
# list whose first item is deeper than a later sibling was truncated at the dedent -- no
# error, no marker. Two judges found it independently.
with section('17. a list must not silently lose items'):
    _h = pr.md("  - first\n- second\n")
    check("dedented sibling survives", "second" in _h, True)
    _h = pr.md("  - A1 fine\n  - A2 fine\n- I reject B3 entirely.\n")
    # Assert CONTENT, not <li> count. Entering at the minimum level wraps an over-indented
    # leading item in a synthetic parent <li>, so the count is 4 -- valid HTML, one extra
    # nesting level, and NOT the defect: the defect was that "I reject B3 entirely." was
    # DELETED. A count assertion here would fail on a correct fix and pass on a lossy one that
    # happened to emit three items; the text is what the reader loses.
    for _t in ["A1 fine", "A2 fine", "I reject B3 entirely."]:
        check(f"item survives: {_t[:22]!r}", _t in _h, True)
    check("ordinary nesting still nests", "<ul><li>a<ul><li>b" in pr.md("- a\n  - b\n"), True)

# --- 18. fences: info strings and length --------------------------------
# ```{python} was not recognised as a fence AT ALL: the code rendered as prose and the
# CLOSING fence became an opener that swallowed the rest of the review into a <pre>.
with section('18. fences: info strings and length'):
    _h = pr.md("```{python}\nx=1\n```\nprose after\n")
    check("brace info string opens a fence", "<pre" in _h and "x=1" in _h, True)
    check("prose after the fence is prose", "<p>prose after</p>" in _h, True)
    _h = pr.md("````\n```\ninner\n```\n````\nafter\n")
    check("a shorter fence does not close a longer one", _h.count("<pre"), 1)
    check("the outer fence still closes", "<p>after</p>" in _h, True)

# --- 19. inline markup ------------------------------------------------------
with section('19. inline markup'):
    check("*** nests correctly", pr._inline("***x***"), "<strong><em>x</em></strong>")
    check("  (pre-fix order produced misnested tags)",
          "<strong><em>x</strong></em>" == "<strong><em>x</strong></em>", True)
    _h = pr.md("| a | b |\n|---|---|\n| `a|b` | ok |\n")
    check("pipe inside a code span is not a cell break", _h.count("<td>"), 2)

# --- 20. decode_letters -----------------------------------------------------
# It rewrote inside `href`, producing markup and quotes inside an attribute; and it carried
# a PRIVATE copy of the adjacent-only pre-fix pattern, so `Reviewer A #2` was grouped by
