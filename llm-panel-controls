# caught this, since the defect is in how the parsed value flows, not in any function.
import subprocess as _sp  # noqa: E402


def _run_cli(args, stdin_text=""):
    return _sp.run([sys.executable, str(SRC), *args], input=stdin_text,
                   capture_output=True, text=True, timeout=120)


