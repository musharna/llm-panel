#   2. finish reason 'length'  -- the model spent its output budget before answering
#   3. a 396-byte answer       -- which was simply a correct answer to a one-line question
# Case 2 spent 470s and $0.58, then reported "our harness failed, not the model" above 600
# bytes of raw JSON -- while meta["finish"] had said 'length' since the stream was parsed.
#
# REAL EXECUTION: these drive the shipped _ask() against a stub `opencode` on PATH, so the
# subprocess, the stream parse and the classification all actually run. A fixture calling
# the classifier directly would have passed against the pre-fix code, because the defect
# was in which exit path the recovery was wired into, not in the classifier.
import os as _os, stat as _stat


def _oc_stub(events):
    _d = pathlib.Path(_tf.mkdtemp())
    _f = _d / "opencode"
    _f.write_text("#!/bin/sh\ncat <<'EOF'\n"
                  + "\n".join(_json.dumps(e) for e in events) + "\nEOF\n")
    _f.chmod(0o755)
    _os.environ["PATH"] = str(_d) + _os.pathsep + _os.environ["PATH"]
    return _d


def _ask_stub(events):
    _os.environ.setdefault("OPENROUTER_API_KEY", "dummy-for-control")
    _oc_stub(events)
    return lp._ask("or-kimi", "q", str(pathlib.Path(_tf.mkdtemp())), 60)


