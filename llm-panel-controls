#!/usr/bin/env python3
"""Regression controls for llm-panel.

Every control here corresponds to a defect that SHIPPED. llm-panel had NO controls at all
until 2026-08-21 -- the tool that runs the audits was the least audited thing in the set.

Each control asserts the FIXED behaviour AND, where the pre-fix input is representable, that
the broken form would have failed on it: an assertion that passes on both the broken and the
fixed code tells you nothing.

    llm-panel-controls          # run them
    llm-panel-controls -v       # show each
"""
import contextlib
import importlib.machinery
import importlib.util
import pathlib
import re
import sys

VERBOSE = "-v" in sys.argv

_sib = pathlib.Path(__file__).resolve().parent / "llm-panel"
SRC = _sib if _sib.is_file() else pathlib.Path.home() / ".local/bin/llm-panel"
spec = importlib.util.spec_from_loader("lp", importlib.machinery.SourceFileLoader("lp", str(SRC)))
lp = importlib.util.module_from_spec(spec)
sys.argv = ["llm-panel", "--help-noop"]
try:
    spec.loader.exec_module(lp)
except SystemExit:
    pass

FAILED = []


@contextlib.contextmanager
def section(name):
    """A control that RAISES must report FAIL, not abort the suite."""
    try:
        yield
    except Exception as e:                                # noqa: BLE001
        FAILED.append(f"{name}: raised {type(e).__name__}: {e}")
        print(f"  FAIL {name} -- raised {type(e).__name__}: {e}")


def check(name, got, want):
    ok = got == want
    if not ok:
        FAILED.append(f"{name}: got {got!r}, want {want!r}")
    if VERBOSE or not ok:
        print(f"  {'ok  ' if ok else 'FAIL'} {name}")


# --- 1. a multi-turn claude answer must not lose every turn but the last -----
# `d = ev` overwrote the result event on each `result` message and the body was read from
# the survivor, so a judge answering across more than one assistant turn had every earlier
# turn DISCARDED -- silently, with status `ok`. Caught by running the 2026-08-21 audit OF
# THIS FILE: claude-opus streamed a 25,673-byte review with 16 findings and 2,569 bytes
# were stored, holding only its closing caveat, which referred to findings that appeared
# nowhere in the run. The complete text was already in `deltas` (that is what .live.md is
# written from) and was thrown away for a field whose completeness cannot be checked.
with section('1. multi-turn claude answer'):
    check("streamed answer wins when the result event is a fragment",
          lp.claude_body(["x" * 5000], {"result": "y" * 100})[0], "x" * 5000)
    check("and the discrepancy is REPORTED, not silently resolved",
          bool(lp.claude_body(["x" * 5000], {"result": "y" * 100})[1]), True)
    # positive controls: the ordinary single-turn path must be untouched
    check("no deltas -> the result event is the answer",
          lp.claude_body([], {"result": "the answer"})[0], "the answer")
    check("result longer -> the result event wins",
          lp.claude_body(["frag"], {"result": "a longer canonical result"})[0],
          "a longer canonical result")
    check("equal text -> no spurious note", lp.claude_body(["hi"], {"result": "hi"})[1], "")
    check("both empty is empty, not a crash", lp.claude_body([], {})[0], "")
    # the PRE-FIX form must lose the review, or this control proves nothing
    _prefix = lambda deltas, d: (d.get("result") or "").strip()      # noqa: E731
    check("  (pre-fix form kept only the fragment)",
          len(_prefix(["x" * 5000], {"result": "y" * 100})), 100)

    # replayed against the REAL artifacts of the run that exposed it, when present
    _R = pathlib.Path.home() / ".llm-panel/runs/user-5de41d3c2d5a/20260821-212351-167027"
    if (_R / "claude-opus.live.md").is_file():
        _live = (_R / "claude-opus.live.md").read_text(encoding="utf-8")
        _kept = (_R / "claude-opus.md").read_text(encoding="utf-8")
        _t, _n = lp.claude_body([_live], {"result": _kept})
        check("real run: the 16-finding review is recovered", len(_t) > 20000, True)
        check("real run: the fragment alone was what shipped", len(_kept) < 3000, True)

# --- 2. the write boundary must fail toward UNSAFE ---------------------------
# Enumerating four tools that write is a bet that the tool universe is closed. It is not,
# and the bet has lost three times on this one boundary (permission-has-no-write-key;
# subagent-falls-back-to-build; custom tools). All 4 judges of the 2026-08-21 audit raised
# it again, each by a different route. Inverted to a read-only ALLOW-LIST: a tool that is
# enabled and not known-read-only counts as writable, so unknown fails toward unsafe --
# the only direction it is safe to be wrong in.
import json as _json, tempfile as _tf

with section('2. write boundary fails toward unsafe'):
    _d = pathlib.Path(_tf.mkdtemp())
    _real = lp.CONFIG_DIR

    def _cfg(obj, root=None):
        (pathlib.Path(root or _d) / "opencode.json").write_text(_json.dumps(obj))

    def _verdict(obj):
        lp.CONFIG_DIR = _d
        try:
            _cfg(obj)
            return lp.agent_can_write("panelist")
        finally:
            lp.CONFIG_DIR = _real

    W = {"write": False, "edit": False, "patch": False, "bash": False}
    check("array-form tools answers instead of crashing",
          _verdict({"agent": {"panelist": {"tools": ["read", "write"]}}}), True)
    check("an MCP/custom write tool counts as writable",
          _verdict({"agent": {"panelist": {"tools": {**W, "filesystem_write_file": True}}}}), True)
    check("`shell` counts as writable",
          _verdict({"agent": {"panelist": {"tools": {**W, "shell": True}}}}), True)
    check("`task` (which grants every other tool) counts as writable",
          _verdict({"agent": {"panelist": {"tools": {**W, "task": True}}}}), True)
    check("no tools grant at all is NOT a clearance",
          _verdict({"agent": {"panelist": {"description": "x"}}}), True)
    check("a shape we do not understand is not a clearance",
          _verdict({"agent": {"panelist": {"tools": "everything"}}}), True)
    # POSITIVE CONTROLS: a genuinely read-only agent must still clear, or the guard is
    # useless in the other direction and every run dies.
    check("a genuinely read-only grant still clears",
          _verdict({"agent": {"panelist": {"tools": {**W, "read": True, "grep": True,
                                                     "glob": True, "list": True}}}}), False)
    check("an undefined agent is unknown, not safe",
          _verdict({"agent": {"other": {"tools": {}}}}), None)
    check("THE SHIPPED opencode.jsonc still certifies panelist read-only",
          lp.agent_can_write("panelist"), False)
    # repo-local override: opencode loads a project config from the tree under review
    _r = pathlib.Path(_tf.mkdtemp())
    _cfg({"agent": {"panelist": {"tools": {"write": True}}}}, _r)
    check("a repo-local config re-enabling write is seen",
          lp.agent_can_write("panelist", _r), True)
    # the pre-fix predicate MUST clear the custom-tool config, or this proves nothing
    _pre = lambda t: any((t or {}).get(x, True) for x in ("write", "edit", "patch", "bash"))
    check("  (pre-fix predicate cleared the custom-tool config)",
          _pre({**W, "filesystem_write_file": True}), False)
    # written first as `isinstance(... if False else None, object)` -- a tautology that
    # passes on anything. That is the defect class this whole file exists to catch, so it
    # is asserted properly: the pre-fix predicate must actually RAISE on the array form.
    try:
        _pre(["read", "write"])
        check("  (pre-fix predicate crashed on the array form)", "no exception", "AttributeError")
    except AttributeError:
        check("  (pre-fix predicate crashed on the array form)", "AttributeError", "AttributeError")

# --- 3. one letter map, not two ---------------------------------------------
# Round 2 assigned letters over `status == "ok"`; run.json rebuilt its own over
# `ok` + `incomplete`. One incomplete judge shifts every later letter, so a renderer
# attributes each `B<n>` to the WRONG judge -- silently, both maps internally consistent.
# Raised by codex and opus. Two constructions of one fact IS the defect.
with section('3. one letter map'):
    _judges = ["codex", "big-pickle", "nemotron"]
    _res = {"codex": {"status": "ok"}, "big-pickle": {"status": "incomplete"},
            "nemotron": {"status": "ok"}}
    # Bound to the SHIPPED assigner, not a copy of it: written first as local arithmetic,
    # which made this control an echo of my own reasoning and left it GREEN against the
    # pre-fix binary -- the exact failure mode this suite exists to catch.
    _round2 = lp.assign_letters(_judges, _res)
    _emitted = {L: j for j, L in _round2.items()}
    check("letters skip a judge that did not answer", _round2, {"codex": "A", "nemotron": "B"})
    check("run.json agrees with the round that assigned the letters",
          _emitted, {"A": "codex", "B": "nemotron"})
    # the PRE-FIX construction must disagree, or this proves nothing
    _pre = {chr(ord("A") + i): j for i, j in
            enumerate(j for j in _judges if _res[j]["status"] in ("ok", "incomplete"))}
    check("  (pre-fix map put B on the wrong judge)", _pre["B"], "big-pickle")
    check("  (and round 2 meant nemotron by B)", _round2["nemotron"], "B")

# --- 4. every phase that spent money is counted ------------------------------
# The Cost section was assembled BEFORE the rebuttal and synthesis had run, and
# run_rebuttals' results were discarded into `_`. Measured on a live 2-judge --rebut run
# 2026-08-21: round 1 $0.0085, rebuttal $0.0146 -- the rebuttal cost MORE than round one
# and was reported as zero, a ~60% under-report. Raised by codex and opus.
with section('4. all phases counted'):
    _r1 = [{"cost": 0.0085, "billing": None, "tokens": {"input": 10, "output": 1}}]
    _r2 = [{"cost": 0.0146, "billing": None, "tokens": {"input": 20, "output": 2}}]
    _sum = lambda ms, sub: sum(m.get("cost") or 0 for m in ms
                               if (m.get("billing") == "subscription") == sub)  # noqa: E731
    check("both phases add up", round(_sum(_r1 + _r2, False), 4), 0.0231)
    check("  (round one alone was the pre-fix figure)", round(_sum(_r1, False), 4), 0.0085)
    check("subscription stays separate from billed", _sum(_r1 + _r2, True), 0)
    # C1: unknown is not zero
    _none = [{"cost": None, "billing": None}, {"cost": None, "billing": None}]
    check("no transport priced anything -> not a measured zero",
          sum(1 for m in _none if m.get("cost") is not None), 0)
    check("  (summing them would have said $0.0000)", _sum(_none, False), 0)
    # First written as a source grep for "UNMEASURED, not zero" -- which FAILED, because
    # the literal spans a line break in the source. A control that greps for a string is
    # testing the text, not the behaviour; the logic is a function now and is called.
    check("no price reported -> says UNMEASURED",
          "UNMEASURED" in lp.billed_note(0, 0), True)
    check("priced and genuinely zero -> says nothing metered",
          lp.billed_note(0, 3), " (nothing metered)")
    check("a real bill gets no qualifier at all", lp.billed_note(1.25, 3), "")

# --- 5. blame lands on the right party ---------------------------------------
# 401/402 are OUR account and were reported as the model REFUSING -- `--check` printed
# refused=4 with "You have depleted your credits". 5xx is the provider failing and fell
# through to `harness`, whose text says the fault is on our side. Raised by all 4 judges.
with section('5. blame classification'):
    def _st(code):
        return lp._classify_error("j", {"name": "APIError", "status": code,
                                        "message": "m"}, 1.0, {})["status"]
    check("401 (our key) is ours", _st(401), "harness")
    check("402 (our credits) is ours", _st(402), "harness")
    check("403 (provider forbids) is a refusal", _st(403), "refused")
    for c in (429, 500, 502, 503, 504, 529):
        check(f"{c} is provider-unavailable, not our plumbing", _st(c), "unavailable")
    check("an unmapped code is still ours", _st(418), "harness")
    # pre-fix maps must disagree, or this proves nothing
    check("  (pre-fix called 402 a refusal)", 402 in {401: 1, 402: 1, 403: 1}, True)
    check("  (pre-fix had no 5xx entry at all)", 500 in {429: 1, 503: 1, 529: 1}, False)

# --- 6. a vision check that can fail -----------------------------------------
# The needle was written INTO the text prompt and the reply was never inspected, so a
# blank image returned `ok` whether the judge answered the needle or CANNOT_SEE.
with section('6. vision check can fail'):
    check("the needle on the first line passes",
          lp.vision_verdict("PELICAN-42\nreview...", "PELICAN-42")[0], True)
    check("case-insensitive", lp.vision_verdict("pelican-42", "PELICAN-42")[0], True)
    check("CANNOT_SEE fails", lp.vision_verdict("CANNOT_SEE", "PELICAN-42")[0], False)
    check("an answer that ignores the image fails",
          lp.vision_verdict("I reviewed the code and found...", "PELICAN-42")[0], False)
    check("empty fails", lp.vision_verdict("", "PELICAN-42")[0], False)
    check("failure says why", "did not see" in lp.vision_verdict("x", "N")[1]
          or "could not read" in lp.vision_verdict("x", "N")[1], True)
    check("the needle is not named in the prompt the judge receives",
          "{vision_check}" in __import__("inspect").getsource(lp._ask), False)

# --- 7. consensus is not manufactured from a shared basename ------------------
# `f.split("/")[-1]` discarded the directory, so src/config.py:20 and tests/config.py:20
# merged into one row reporting 2/2 agreement between judges reading DIFFERENT files.
with section('7. consensus file identity'):
    check("same file cited two ways matches", lp.same_file("config.py", "src/config.py"), True)
    check("different directories do NOT match",
          lp.same_file("src/config.py", "tests/config.py"), False)
    check("./ prefix matches", lp.same_file("./config.py", "src/config.py"), True)
    check("deeper suffix matches", lp.same_file("a/b/c.py", "b/c.py"), True)
    _res = {"A": {"status": "ok", "text": "bug at src/config.py:20"},
            "B": {"status": "ok", "text": "bug at tests/config.py:20"}}
    check("no false 2/2 across different files",
          any("2/2" in r for r in lp.consensus_view(["A", "B"], _res)), False)
    _res2 = {"A": {"status": "ok", "text": "bug at config.py:20"},
             "B": {"status": "ok", "text": "bug at src/config.py:20"}}
    check("real agreement still reported",
          any("2/2" in r for r in lp.consensus_view(["A", "B"], _res2)), True)
    check("  (pre-fix basename collapse merged them)",
          "src/config.py".split("/")[-1] == "tests/config.py".split("/")[-1], True)

# --- 8. the single-argv ceiling is checked before launching -------------------
# MEASURED on this machine: 131,071 bytes passes, 131,072 raises E2BIG. Every CLI transport
# passes the prompt as one argv element, so an oversize prompt killed codex, claude and
# opencode simultaneously with a bare OSError.
with section('8. argv ceiling'):
    check("the limit used is the measured one", lp.MAX_ARGV_BYTES, 131_072)
    _r = lp._ask("codex", "x" * 200_000, "/tmp", 5)
    check("oversize prompt fails as harness", _r["status"], "harness")
    check("and names the real cause", "MAX_ARG_STRLEN" in _r["text"], True)
    check("without launching anything", _r["secs"] < 2.0, True)

# --- 9. an ollama session is resumable only if it can be REPLAYED -------------
# The banner counted any non-empty file as resumable while ask() dropped malformed JSON,
# so `{broken` announced "1 judge resuming" and then sent no context at all.
with section('9. ollama session'):
    import tempfile as _t2
    _d2 = pathlib.Path(_t2.mkdtemp())
    _bad = _d2 / "b.session"; _bad.write_text("{broken")
    _empty = _d2 / "e.session"; _empty.write_text("[]")
    _good = _d2 / "g.session"; _good.write_text("[1,2,3]")
    check("malformed is not resumable", lp.ollama_context(_bad), None)
    check("empty list is not resumable", lp.ollama_context(_empty), None)
    check("a real context is resumable", lp.ollama_context(_good), [1, 2, 3])
    check("  (pre-fix banner counted the malformed file as resumable)",
          bool(lp.read_session(_bad)), True)

# --- 10. --diff must not read out of the repository --------------------------
# `git ls-files --others` reports an untracked SYMLINK by its in-repo path and opening it
# followed the link out of the tree: a secret file's contents were embedded in the prompt
# sent to every REMOTE judge. Verified by execution 2026-08-21.
with section('10. diff symlink containment'):
    import subprocess as _sp, tempfile as _t3
    _w = pathlib.Path(_t3.mkdtemp()); _repo = _w / "repo"; _repo.mkdir()
    (_w / "secret.txt").write_text("SENTINEL-DO-NOT-LEAK\n")
    _sp.run(["git", "init", "-q", str(_repo)], check=True)
    (_repo / "main.py").write_text("x = 1\n")
    _sp.run(["git", "-C", str(_repo), "add", "main.py"], check=True)
    _sp.run(["git", "-C", str(_repo), "-c", "user.email=a@b", "-c", "user.name=c",
             "commit", "-qm", "init"], check=True)
    (_repo / "newfile.py").write_text("def real_new_code(): pass\n")
    (_repo / "linked.txt").symlink_to(_w / "secret.txt")
    _d3 = lp.collect_diff(str(_repo))
    check("a symlink out of the repo is NOT read", "SENTINEL-DO-NOT-LEAK" in _d3, False)
    check("and the omission is reported", "NOT read" in _d3, True)
    check("a genuine untracked file is still included", "real_new_code" in _d3, True)

# --- 11. run-directory containment is PHYSICAL -------------------------------
with section('11. containment is physical'):
    _l = _w / "cachelink"
    (_repo / ".cache").mkdir(exist_ok=True)
    _l.symlink_to(_repo / ".cache")
    check("a symlink into the repo is detected", lp.cache_is_inside(_l, _repo), True)
    check("a genuinely outside cache is not", lp.cache_is_inside("/home", _repo), False)
    check("a relative path resolves before comparing",
          lp.cache_is_inside(_repo / ".cache" / "..", _repo), True)
    check("  (the lexical test missed it)",
          str(_l).startswith(str(_repo) + "/"), False)

# --- 12. a repo is its REAL path ---------------------------------------------
with section('12. repo identity'):
    _alias = _w / "repo-link"
    _alias.symlink_to(_repo)
    check("an aliased path yields the SAME run key",
          lp.repo_key(str(_alias)), lp.repo_key(str(_repo)))
    check("and the same thread key",
          lp.thread_key("design", str(_alias)), lp.thread_key("design", str(_repo)))

# --- 13. round-2 anonymity: position must carry no information ---------------
# Letters followed ROSTER ORDER, so a judge that knows the roster maps every letter to a
# name -- and in the 2026-08-21 audit the roster sat in the file under review, in a ROSTER
# dict, in order. All four judges raised it. Reproduced before fixing: with five judges
# or-kimi sees A,B,D,E, learns it is C, and roster order gives it the rest.
with section('13. rebuttal anonymity'):
    _J = ["codex", "claude-opus", "or-kimi", "or-deepseek", "or-glm"]
    _R = {j: {"status": "ok"} for j in _J}
    _ro = [chr(ord("A") + i) for i in range(len(_J))]
    _same = sum(1 for i in range(12)
                if [lp.assign_letters(_J, _R, seed=f"s{i}")[j] for j in _J] == _ro)
    check("letters do not track roster order", _same <= 1, True)
    check("stable within one run (prompt, legend and run.json must agree)",
          lp.assign_letters(_J, _R, seed="X"), lp.assign_letters(_J, _R, seed="X"))
    check("different runs differ",
          lp.assign_letters(_J, _R, seed="X") != lp.assign_letters(_J, _R, seed="Y"), True)
    check("still a bijection", sorted(lp.assign_letters(_J, _R, seed="X").values()), _ro)
    _R2 = dict(_R); _R2["or-kimi"] = {"status": "harness"}
    _m2 = lp.assign_letters(_J, _R2, seed="X")
    check("a judge that did not answer gets no letter", "or-kimi" in _m2, False)
    check("and the rest stay contiguous", sorted(_m2.values()), ["A", "B", "C", "D"])
    # the pre-fix assignment MUST equal roster order, or this proves nothing
    _pre = {j: chr(ord("A") + i)
            for i, j in enumerate([j for j in _J if _R[j]["status"] == "ok"])}
    check("  (pre-fix assignment WAS roster order)", [_pre[j] for j in _J], _ro)

# --- 14. the 2026-08-22 re-audit --------------------------------------------
# A second panel reviewed this file after the 22 fixes of 2026-08-21, with abstention
# licensed. or-glm returned ZERO findings on two areas it named as examined-and-clean, and
# then found the one below that mattered most. codex returned 14 and abstained on three.
with section('14. re-audit findings'):
    import json as _j5, tempfile as _t5

    # #3 -- A CRASH INTRODUCED BY THE 2026-08-21 FIX ITSELF. Growing the main return to
    # three values missed the early skip branch, so `--judges X --rebut` raised ValueError
    # out of main() and wrote NO panel.md and NO run.json: the whole run lost on the
    # ordinary path where only one judge answers.
    import inspect as _i5
    _src5 = _i5.getsource(lp.run_rebuttals)
    check("the skip branch returns three values",
          _src5.count("return ([\"\", \"_Rebuttal round skipped") or
          "}, {})" in _src5.split("Rebuttal round skipped")[1][:200], True)

    # #5 -- an explicit denial outranks a substring match
    check("'CANNOT_SEE CAT' fails the vision check",
          lp.vision_verdict("CANNOT_SEE CAT", "CAT")[0], False)
    check("  (a real sighting still passes)", lp.vision_verdict("CAT\nreview", "CAT")[0], True)

    # #11 -- 408 means the provider was reached and timed out
    check("408 is provider-unavailable",
          lp._classify_error("j", {"name": "E", "status": 408, "message": "m"}, 1, {})["status"],
          "unavailable")

    _d5 = pathlib.Path(_t5.mkdtemp())
    _real5 = lp.CONFIG_DIR

    def _verdict5(text):
        lp.CONFIG_DIR = _d5
        try:
            (_d5 / "opencode.json").write_text(text)
            return lp.agent_can_write("panelist")
        finally:
            lp.CONFIG_DIR = _real5

    # #10 -- a VALID JSONC config was read as "unknown" and killed the run with exit 9
    check("inline comments and trailing commas parse",
          _verdict5('{\n "agent": { // primary\n  "panelist": {"tools": ["read"]},\n }\n}'), False)
    check("a // inside a STRING is not stripped as a comment",
          _verdict5('{"agent":{"panelist":{"description":"see http://x","tools":["read"]}}}'), False)
    # #1 -- opencode refuses a subagent and falls back to write-capable `build`
    check("mode:subagent counts as writable",
          _verdict5('{"agent":{"panelist":{"mode":"subagent","tools":["read","grep"]}}}'), True)
    check("  (a primary read-only agent still clears)",
          _verdict5('{"agent":{"panelist":{"mode":"primary","tools":["read","grep"]}}}'), False)

    # #4 / or-glm -- shuffling the LETTERS was only half the fix; the BLOCKS were still
    # emitted in roster order, so position gave the mapping away regardless of the letter.
    _J5 = ["codex", "big-pickle", "nemotron", "deepseek"]
    _R5 = {j: {"status": "ok"} for j in _J5}
    _same = 0
    for _s5 in [f"s{i}" for i in range(12)]:
        _L5 = lp.assign_letters(_J5, _R5, seed=_s5)
        for _me in _J5:
            _oth = sorted((o for o in _J5 if o != _me), key=lambda o: _L5[o])
            if _oth == [o for o in _J5 if o != _me]:
                _same += 1
    check("block order no longer tracks roster order for every judge", _same < 12, True)
    check("the shipped code sorts by letter",
          "key=lambda o: letters[o]" in SRC.read_text(encoding="utf-8"), True)

    # #2 -- reviewing a repo rooted at $HOME put the FALLBACK inside it too
    _home = str(pathlib.Path.home())
    check("the usual fallback is detected as inside a $HOME-rooted repo",
          lp.cache_is_inside(pathlib.Path(_home) / ".llm-panel", _home), True)

    # #9 -- the size check must be the LAST thing before dispatch
    _r9 = lp._ask("codex", "-x" * 70000, "/tmp", 5)
    check("an oversize prompt is caught AFTER the leading-dash fix", _r9["status"], "harness")
    check("  and it names the real cause", "MAX_ARG_STRLEN" in _r9["text"], True)

# --- 15. oversized material is spilled to a file, not refused ---------------
# The argv ceiling stopped llm-panel auditing ITSELF: round two re-sends the full source
# plus every review, hit 153,506 bytes, and ALL FOUR judges were refused, so the rebuttal
# produced nothing. Refusing was right as a guard (it replaced a bare OSError) but is not an
# answer for a panel whose job is reviewing large files.
with section('15. material spill'):
    import tempfile as _t6
