# --- roster config ------------------------------------------------------------------
# The built-in ROSTER names one person's accounts. Making it config-driven is what lets
# anyone else run this, so the loader gets controls on BOTH halves: that a good config
# does what it says, and that a bad one dies loudly instead of quietly running a panel
# the author did not ask for -- which would bill them for it.
#
# Every negative below is paired with `roster.0 valid config still loads` running in the
# SAME harness. Without that, a loader broken so badly it rejected everything would score
# a perfect run of "correctly refused", and read as green.
import json as _json          # noqa: E402
import tempfile               # noqa: E402


def _load(obj, roster=None, default=None):
    """Run load_roster over a config written to a real file. Returns (default, roster,
    families, added). Raises ValueError exactly as the tool would."""
    roster = lp._Roster(dict(lp.SHIPPED_ROSTER) if roster is None else roster)
    fams, added = {}, set()
    with tempfile.TemporaryDirectory() as td:
        p = pathlib.Path(td) / "roster.json"
        p.write_text(obj if isinstance(obj, str) else _json.dumps(obj), encoding="utf-8")
        d = lp.load_roster(p, roster, list(default or lp.SHIPPED_DEFAULT), fams, added)
    return d, roster, fams, added


def _rejects(name, obj, fragment):
    """Assert the config is refused AND that the message names the actual problem.
    'some exception was raised' passes on a loader that rejects everything."""
    with section(name):
        try:
            _load(obj)
        except ValueError as e:
            check(f"{name} message names the problem", fragment in str(e), True)
            if fragment not in str(e):
                print("      message was:", e)
        else:
            check(f"{name} was refused", "accepted", "refused")


